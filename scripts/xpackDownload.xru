// =============================================================================
// Template Bundle Downloader & Cache Resolver: scripts/xpackDownload.xru
// =============================================================================
// Handles GitHub release resolution, progress-tracked archive download, and
// local cache management (~/.xfpm/cache/) for project.xpack.
// =============================================================================

mod XpackD

use std
use net as Net
use fs as Fs
use json as Json
use sys as Sys

Sys.require(">= 2.0.13", @map{
    onMismatch: "auto-update",
    mode: "log"
});

unit ReleaseDownloader {
    declare private repo: string = "Nehonix-Team/xypriss-templates"
    declare private cacheDir: string = ""
    declare public latestVersion: string = ""

    func printErr(err: string) -> void {
        const e = "Downloading error: $f{err}"
        std.fatal(e)
    }

    func fetchLatestMetadata() -> string {
        const url = "https://api.github.com/repos/$f{&repo}/releases/latest"
        std.print("<yellow>[FETCHING]</> Querying latest template release...")

        let downloadTask = with Net.fetch(url)

        while downloadTask.isDone() == false {
            std.print("<cyan>.</>")
            std.sleep(120ms)
        }
        std.println("")

        const result = downloadTask.wait() catch dErr
        if dErr != nil {
            &self::printErr(dErr)
        }

        const parsedResult = Json.parse(result) catch err
        if err != nil {
            &self::printErr("Failed to parse metadata JSON: $f{err}")
        }

        &latestVersion =: parsedResult.tag_name
        return result
    }

    func resolveBundle() -> string {
        &cacheDir =: "$f{Sys.homeDir()}/.xfpm/cache"
        Fs.ensureDir(&cacheDir)

        &self::fetchLatestMetadata()

        if !&latestVersion {
            std.fatal("Failed to resolve latest template version from GitHub")
        }

        const targetBundle = "$f{&cacheDir}/project-$f{&latestVersion}.xpack"

        if Fs.exists(targetBundle) {
            std.println("<green>[CACHE]</> Using cached template bundle <bold>$f{&latestVersion}</>")
            return targetBundle
        }

        const downloadUrl = "https://github.com/$f{&repo}/releases/download/$f{&latestVersion}/project.xpack"
        std.print("<blue>[DOWNLOADING]</> Fetching template bundle <bold>$f{&latestVersion}</>...")

        let dTask = with Net.fetch(downloadUrl)

        while dTask.isDone() == false {
            std.print("<cyan>.</>")
            std.sleep(120ms)
        }
        std.println("")

        const dResult = dTask.wait() catch dErr
        if dErr != nil {
            &self::printErr("Failed to download project bundle: $f{dErr}")
        }

        Fs.write(targetBundle, dResult)
        std.println("<green>[SAVED]</> Template bundle cached at '<bold>$f{targetBundle}</>'")
        return targetBundle
    }
}

// -----------------------------------------------------------------------------
// Exported global entrypoint for init.xru
// -----------------------------------------------------------------------------
global func resolveBundle() -> string {
    let downloader = @ReleaseDownloader()
    return downloader.resolveBundle()
}

global func downloadRelease() {
    let downloader = @ReleaseDownloader()
    downloader.resolveBundle()
}