//----------------------------- THIS WILL DOWNLOAD THE LATEST VERSION OF TEMPLATE
// this is the main script for xfpm when running "xfpm init"

mod XpackD

use std
use sys
use net as Net
use fs as Fs
use json as Json

// 2. Mode auto-update (télécharge directement la release GitHub et relance le process)
sys.require(">= 2.0.13", @map{
   onMismatch: "auto-update"
   mode: "log"
});

// =============================================================================
// Unit: ReleaseDownloader
// =============================================================================
// Encapsulates release metadata querying, progress-tracked async download,
// error reporting, and archive persistence.
// =============================================================================
unit ReleaseDownloader {
    declare private repo: string = "Nehonix-Team/xypriss-templates"
    declare public archiveFileName: string = "xypriss-template-20260609.zip"
    declare public latestVersion: string = ""

    func printErr(err: string) -> void {
        const e = "Downloading error: $f{err}"
        std.fatal(e)
    }

    func fetchLatestMetadata() -> string {
        const url = "https://api.github.com/repos/$f{&repo}/releases/latest"
        std.print("<yellow>[FETCHING]</> Querying latest release...")

        let downloadTask = with Net.fetch(url)

        // Affichage du loader tant que la requête async est en cours
        while downloadTask.isDone() == false {
            std.print("<cyan>.</>")
            std.sleep(140ms)
        }
        std.println("")

        const result = downloadTask.wait() catch dErr
        if dErr != nil {
            &self::printErr(dErr)
        }

        const parsedResult = Json.parse(result) catch err
        if err != nil {
            &self::printErr("Failed to parse metadata JSON: $f{err}")
        }

        &latestVersion =: parsedResult.tag_name
        return result
    }

    func downloadArchive() -> void {
        const downloadUrl = "https://github.com/$f{&repo}/releases/latest/download/$f{&archiveFileName}"
        std.print("<blue>[DOWNLOADING]</> Fetching template archive")

        let dTask = with Net.fetch(downloadUrl)

        // Loader durant le téléchargement de l'archive
        while dTask.isDone() == false {
            std.print("<cyan>.</>")
            std.sleep(120ms)
        }
        std.println("")

        const dResult = dTask.wait() catch dErr
        if dErr != nil {
            &self::printErr("Failed to download archive: $f{dErr}")
        }

       if Fs.exists(&archiveFileName) {
            std.println("<yellow>[WARNING]</> Archive already exists, overwriting")
            Fs.remove(&archiveFileName) catch e 
            if e != nil {
                &self::printErr("Failed to remove existing archive: $f{e}")
            }
            else {
                std.println("<green>[SUCCESS]</> Removed existing archive")
            }
        }

       Fs.write(&archiveFileName, dResult)
            
    }

    func Exec() -> void {
        &self::fetchLatestMetadata()

        if !&latestVersion {
            std.fatal("Failed to fetch latest version")
        }

        &self::downloadArchive()
        std.println("<green>[SUCCESS]</> Fetched release info for version: <bold>$f{&latestVersion}</>")
        std.println("<blue>[SAVED]</> Template archive written to '<bold>$f{&archiveFileName}</>'")
    }
}

// -----------------------------------------------------------------------------
// Entrypoint exporté pour le runner/orchestrateur racine (main.xru)
// -----------------------------------------------------------------------------
global func downloadRelease() {
    let downloader = @ReleaseDownloader()
    downloader.Exec()
    // std.println("<bold>archiveFileName: </bold>$f{downloader.archiveFileName}")
    // if !downloader.latestVersion {std.println("<bold>latestVersion: </bold>$f{downloader.latestVersion}")}
}

::downloadRelease()