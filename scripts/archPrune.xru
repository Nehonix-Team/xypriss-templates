// =============================================================================
// Architecture Pruning Pipeline: scripts/archPrune.xru
// =============================================================================
// Performs surgical code and AST modifications on backend source files
// (`src/server.ts`, `src/router.ts`, and `xypriss.config.jsonc`) according to
// the active execution preset (`mode == "minimal"` or `cdn == false`).
// Uses XRU Document surgical APIs (`removeBetween`, `replaceFuzzy`, `removeBalanced`).
// =============================================================================

mod prune

from "dll" use gArgs::cdn
from "dll" use gArgs::mode
use fs as Fs

/// Surgically prunes CDN and Multi-Server nodes from server, router, and configs.
global func arch() {
    if mode == "minimal" || cdn == false {
        file "src/server.ts", (doc, err) -> {
            if err != nil { return }
            // Remove CDN paths import
            doc.removeBetween("import {\n  permanentCdnPath", "} from \"./const/cdnPaths\";", true, true)

            // Remove XStatic from xypriss import
            doc.replaceFuzzy(<<<import { createServer, XStatic } from "xypriss";>>>, <<<import { createServer } from "xypriss";>>>)

            // Remove entire XStatic setup block while preserving app.start()
            doc.removeBetween("// 3. Configure secure static asset sandboxing with XStatic", "// 4. Start the server listener and event loop", true, false)
            doc.removeLines("Establishing sandboxed static asset delivery routes", true)
            doc.cleanGaps()
        }

        file "src/router.ts", (doc, err) -> {
            if err != nil { return }
            if mode == "minimal" {
                // Mode minimal: strip auth and cdn router groups and servers
                doc.removeBetween(<<<r.group({ prefix: ["/auth", "/api"]>>>, "});", true, true)
                doc.removeBetween(<<<r.group({ prefix: "/cdn">>>, "});", true, true)
                doc.removeLines("AUTH SERVER", true)
                doc.removeLines("CDN SERVER", true)
                doc.removeLines("Dedicated authentication server", true)
                doc.removeLines("Content Delivery Network", true)
                doc.removeLines("// ==============================", true)
                doc.replaceFuzzy(<<<r.group({ prefix: ["/api", "/"], serverId: mainServer.id }, (api) => {>>>, 
                <<<r.group({ prefix: ["/api", "/"] }, (api) => {>>>)
                doc.replaceFuzzy(<<</**
 * Primary REST API gateway handling business logic and core services.
 *
 * Mapped to `mainServer.id` with dual prefix capability `["/api", "/"]`.
 * - If `mainServer.routePrefix: "/api"` is active in `api.server.ts`,
 *   only `/api` requests reach this group (`/` yields 404).
 * - If `mainServer.routePrefix` is commented out / omitted,
 *   both `/api` and `/` resolve to `apiRouter`.
 */>>>, <<</**
 * Primary REST API gateway handling business logic and core services.
 */>>>)
                doc.removeLines("auth.route", true)
                doc.removeLines("authRouter", true)
                doc.removeLines("api.server", true)
                doc.removeLines("auth.server", true)
            } elif cdn == false {
                // CDN disabled: strip cdn router group
                doc.removeBetween(<<<r.group({ prefix: "/cdn">>>, "});", true, true)
                doc.removeLines("CDN SERVER", true)
                doc.removeLines("Content Delivery Network", true)
            }
            // Remove common CDN imports
            doc.removeLines("cdn.route", true)
            doc.removeLines("cdnRouter", true)
            doc.removeLines("cdn.server", true)
            doc.removeLines("cdnServer", true)
            doc.cleanGaps()
        }

        if Fs.exists("xypriss.config.jsonc") {
            file "xypriss.config.jsonc", (doc, err) -> {
                if err != nil { return }
                if mode == "minimal" {
                    doc.removeBalanced(<<<"servers": {>>>, "{", "}")
                } elif cdn == false {
                    doc.removeBalanced(<<<"cdn": {>>>, "{", "}")
                }
            }
        }
    }
}