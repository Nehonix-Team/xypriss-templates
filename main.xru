// Module name (use fileName if nothing is provided)
mod main


use std
use fs as Fs
use cmd as Cmd
use crypto as Crypto
use sys as Sys
from "dll" use HM::HydratateMetaD

// =============================================================================
// Root Orchestration Descriptor: main.xru
// =============================================================================
// Orchestrates project setup, template variables hydration, cryptographic secret
// generation, modular pruning based on presets, and dependency installation.
// =============================================================================

// -----------------------------------------------------------------------------
// 1. CLI ARGUMENTS & CONFIGURATION SCHEMA
// -----------------------------------------------------------------------------
from "dll" use gArgs::name 
from "dll" use gArgs::@map{install, port, server_timeout, mode, cdn, database}
from "dll" use prune::arch
from "dll" use dbCleanup::@map{noneDbKeys, prismaDbMap, drizzleDbMap}

let dbChoice = database
if dbChoice == "postgresql" {
    dbChoice =: "drizzle"
}

std::println("<cyan>[XRU]</> Orchestrating template <bold>$f{name}</> (mode: <yellow>$f{mode}</>, db: <magenta>$f{dbChoice}</>)")
const installMsg = if install -> "<green>Dependencies installation enabled</>" else "<yellow>Dependencies installation disabled</>"

std::println("<blue>[XRU]</> $f{installMsg}")

// downloadRelease()



// -----------------------------------------------------------------------------
// 2. DYNAMIC CRYPTOGRAPHIC SECRET GENERATION (.env)
// and .env config
// -----------------------------------------------------------------------------
// in "minimal" mode, we only have 
// XYPRISS_SHIELD; PORT; SERVER_TIMEOUT and XEMS_SECRET
interface EnvObj @map{
    XYPRISS_SHIELD "silent"
    PORT number
    SERVER_TIMEOUT number
    XEMS_SECRET string
}

const xemsSecret: string = Crypto.getRandomBytes(32)
const CEnvObj: EnvObj = @map{
    PORT: port
    SERVER_TIMEOUT: server_timeout
    XEMS_SECRET: xemsSecret
    XYPRISS_SHIELD: "silent"
}


if Fs.exists(".env") {
    file ".env", (doc, err) -> {
        if err != nil { return }
        if mode == "minimal" {
            let envContent = ""
            for key, val in CEnvObj {
                if val.type() == "number" {
                    envContent =: envContent + "$f{key}=$f{val}\n"
                } else {
                    envContent =: envContent + "$f{key}=\"$f{val}\"\n"
                }
            }
            if dbChoice == "prisma" {
                envContent =: envContent + "DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/$f{name}?schema=public\"\n"
            } elif dbChoice == "drizzle" {
                envContent =: envContent + "DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/$f{name}\"\n"
            }
            doc.setContent(envContent)
        } else {
            doc.removeLines("XEMS_SECRET")
            doc.append("\n") // break line
            doc.append(<<<XEMS_SECRET=$f{xemsSecret}>>>)
            if dbChoice == "prisma" {
                doc.append("\n\n# PostgreSQL Database Connection (Prisma)\nDATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/$f{name}?schema=public\"\n")
            } elif dbChoice == "drizzle" {
                doc.append("\n\n# PostgreSQL Database Connection (Drizzle)\nDATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/$f{name}\"\n")
            }
        }
    }
}

if Fs.exists(".gitignore") {
    file ".gitignore", (doc, err) -> {
        if err != nil { return }
        doc.append("\n# Environment variables & secrets\n.env\n.env.*\n.env.local\n.env.remote\n.storage.xems\n")
    }
}

// Download "xpack" archive from github
// const res = Net.fetch("") catch err

// -----------------------------------------------------------------------------
// 3. REUSABLE GLOBAL FUNCTIONS (Invoked via ::functionName)
// -----------------------------------------------------------------------------
global func prune(kind: string, mode: string, cdn: bool) {
    if mode == "minimal" {
        drop(["auth.$f{kind}.ts", "cdn.$f{kind}.ts"])
    } elif cdn == false {
        drop(["cdn.$f{kind}.ts"])
    }
}

// -----------------------------------------------------------------------------
// 4. METADATA HYDRATION (package.json & TARGET_README.md)
// -----------------------------------------------------------------------------
HydratateMetaD()

// -----------------------------------------------------------------------------
// 5. ARCHITECTURE PRUNING (src/server.ts & src/router.ts)
// -----------------------------------------------------------------------------
arch()

// -----------------------------------------------------------------------------
// 5. DISPATCH TREE EXECUTION (Scoped Subdescriptors)
// -----------------------------------------------------------------------------
dispatch "./src"

if mode == "minimal" {
    if Fs.exists("src/servers") {
        Fs.remove("src/servers")
    }
}

// -----------------------------------------------------------------------------
// 5b. DATABASE & ORM ROOT PRUNING
// -----------------------------------------------------------------------------
if dbChoice == "none" {
    if Fs.exists("drizzle.config.ts") {
        Fs.remove("drizzle.config.ts")
    }
    if Fs.exists("prisma.config.ts") {
        Fs.remove("prisma.config.ts")
    }
    if Fs.exists("prisma") {
        Fs.remove("prisma")
    }
    file "package.json", (doc, err) -> {
        if err != nil { return }
        for key in noneDbKeys {
            doc.removeJson(key)
        }
    }
} elif dbChoice == "drizzle" {
    std::println("<cyan>[DATABASE]</> Configuring <bold>Drizzle ORM</> with PostgreSQL...")
    if Fs.exists("prisma.config.ts") {
        Fs.remove("prisma.config.ts")
    }
    if Fs.exists("prisma") {
        Fs.remove("prisma")
    }
    file "drizzle.config.ts", (doc, err) -> {
        if err != nil { return }
        doc.replaceFuzzy("my_xypriss_app", name)
    }
    file "package.json", (doc, err) -> {
        if err != nil { return }
        for key, val in drizzleDbMap {
            doc.setJson(key, val)
        }
    }
} elif dbChoice == "prisma" {
    std::println("<cyan>[DATABASE]</> Configuring <bold>Prisma ORM (v7)</> with PostgreSQL...")
    if Fs.exists("drizzle.config.ts") {
        Fs.remove("drizzle.config.ts")
    }
    file "prisma.config.ts", (doc, err) -> {
        if err != nil { return }
        doc.replaceFuzzy("my_xypriss_app", name)
    }
    file "package.json", (doc, err) -> {
        if err != nil { return }
        for key, val in prismaDbMap {
            doc.setJson(key, val)
        }
    }
}

// -----------------------------------------------------------------------------
// 6. OPTIONAL DEPENDENCY INSTALLATION VIA XFPM
// -----------------------------------------------------------------------------
if install == true {
    std::println("<blue>[INSTALL]</> Installing dependencies via xfpm...")
    Cmd::exec("xfpm install")
    if dbChoice == "prisma" {
        std::println("<cyan>[PRISMA]</> Generating Prisma Client...")
        Cmd::exec("xfpm run db:generate") catch err;
        if err != nil {
            std::println("<yellow>[WARNING]</> Failed to auto-generate Prisma Client: $f{err}")
            std::println("<yellow>[HINT]</> You can run 'xfpm run db:generate' manually.")
        }
    }
}

const scriptFile = "main.xru"
Fs.remove(scriptFile) catch err;
if (err) {
    std::println("<yellow> An error occurred while removing $f{scriptFile} but skipping deletion and continuing...</yellow>");
}

std::println("<green>[SUCCESS]</> Template orchestration completed for <bold>$f{name}</>!")
