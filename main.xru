// Module name (use fileName if nothing is provided)
mod main


use std
use fs as Fs
use cmd as Cmd
use crypto as Crypto
use sys as Sys
from "dll" use HM::HydratateMetaD

// =============================================================================
// Root Orchestration Descriptor: main.xru
// =============================================================================
// Orchestrates project setup, template variables hydration, cryptographic secret
// generation, modular pruning based on presets, and dependency installation.
// =============================================================================

// -----------------------------------------------------------------------------
// 1. CLI ARGUMENTS & CONFIGURATION SCHEMA
// -----------------------------------------------------------------------------
from "dll" use gArgs::name 
from "dll" use gArgs::mode
from "dll" use gArgs::install
from "dll" use gArgs::cdn
// from "dll" use XpackD::downloadRelease
from "dll" use arch::archPrune
from "dll" use gArgs::port
from "dll" use gArgs::server_timeout



std.println("<cyan>[XRU]</> Orchestrating template <bold>$f{name}</> (mode: <yellow>$f{mode}</>)")
const installMsg = if install -> "<green>Dependencies installation enabled</>" else "<yellow>Dependencies installation disabled</>"

std.println("<blue>[XRU]</> $f{installMsg}")

// downloadRelease()



// -----------------------------------------------------------------------------
// 2. DYNAMIC CRYPTOGRAPHIC SECRET GENERATION (.env)
// and .env config
// -----------------------------------------------------------------------------
// in "minimal" mode, we only have 
// XYPRISS_SHIELD; PORT; SERVER_TIMEOUT and XEMS_SECRET
interface EnvObj @map{
    XYPRISS_SHIELD "silent"
    PORT number
    SERVER_TIMEOUT number
    XEMS_SECRET string
}

const xemsSecret: string = Crypto.getRandomBytes(32)
const CEnvObj: EnvObj = @map{
    PORT: port
    SERVER_TIMEOUT: server_timeout
    XEMS_SECRET: xemsSecret
    XYPRISS_SHIELD: "silent"
}


if Fs.exists(".env") {
    file ".env", (doc, err) -> {
        if err != nil { return }
        if mode == "minimal" {
            let envContent = ""
            for key, val in CEnvObj {
                if val.type() == "number" {
                    envContent =: envContent + "$f{key}=$f{val}\n"
                } else {
                    envContent =: envContent + "$f{key}=\"$f{val}\"\n"
                }
            }
            doc.setContent(envContent)
        } else {
            doc.removeLines("XEMS_SECRET")
            doc.append("\n") // break line
            doc.append(<<<XEMS_SECRET=$f{xemsSecret}>>>)
        }
    }
}

// Download "xpack" archive from github
// const res = Net.fetch("") catch err

// -----------------------------------------------------------------------------
// 3. REUSABLE GLOBAL FUNCTIONS (Invoked via ::functionName)
// -----------------------------------------------------------------------------
global func prune(kind: string, mode: string, cdn: bool) {
    if mode == "minimal" {
        drop(["auth.$f{kind}.ts", "cdn.$f{kind}.ts"])
    } elif cdn == false {
        drop(["cdn.$f{kind}.ts"])
    }
}

// -----------------------------------------------------------------------------
// 4. METADATA HYDRATION (package.json & TARGET_README.md)
// -----------------------------------------------------------------------------
HydratateMetaD()

// -----------------------------------------------------------------------------
// 5. ARCHITECTURE PRUNING (src/server.ts & src/router.ts)
// -----------------------------------------------------------------------------
archPrune()

// -----------------------------------------------------------------------------
// 5. DISPATCH TREE EXECUTION (Scoped Subdescriptors)
// -----------------------------------------------------------------------------
dispatch "./src"

if mode == "minimal" {
    if Fs.exists("src/servers") {
        Fs.remove("src/servers")
    }
}

// -----------------------------------------------------------------------------
// 6. OPTIONAL DEPENDENCY INSTALLATION VIA XFPM
// -----------------------------------------------------------------------------
if install == true {
    std.println("<blue>[INSTALL]</> Installing dependencies via xfpm...")
    const cmd = "xfpm -C $f{Sys.cwd()} install"
    std.println("<yellow>Executing: \"$f{cmd}\"</yellow>")
    Cmd.exec(cmd)
}

Fs.remove("main.xru")
std.println("<green>[SUCCESS]</> Template orchestration completed for <bold>$f{name}</>!")
