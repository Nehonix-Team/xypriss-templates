use std

// =============================================================================
// Module Descriptor: src/guards/.rules.xru
// =============================================================================
// Orchestrates authorization and guard lifecycle pruning.
// - In "minimal" mode:
//     1. Drops auth.guard.ts.
//     2. Cleans up index.guard.ts to remove authentication guard references.
// =============================================================================

arg mode: string = "default"

if mode == "minimal" {
    // Drop dedicated authentication guard
    drop(["auth.guard.ts"])

    // Remove obsolete guard exports and imports from the central index aggregator
    file "index.guard.ts", (doc, err) -> {
        if err != nil { return }
        doc.removeLines("auth.guard")
        doc.removeLines("authenticated")
    }
}
