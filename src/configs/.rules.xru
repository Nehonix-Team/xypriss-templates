// =============================================================================
// Module Descriptor: src/configs/.rules.xru
// =============================================================================
// Orchestrates project runtime configurations:
// 1. XEMS Session Management (xemsConfigs.ts):
//    - Toggles the XEMS session engine according to the XEMS flag.
// 2. Server Cluster Topology (xypriss.config.ts):
//    - In "minimal" mode: Strips multi-server topology and isolates single-app runtime.
//    - When CDN is disabled: Removes CDN server reference from the cluster array.
// =============================================================================

arg mode: string = "default"
arg xems: bool = true
arg cdn: bool = true

// -----------------------------------------------------------------------------
// 1. XEMS Session Management Configuration
// -----------------------------------------------------------------------------
if xems == false {
    Utils.log("<yellow>[XEMS: DISABLED]</> Disabling XEMS session engine in xemsConfigs.ts")
    file "xemsConfigs.ts" {
        replace("    enable: true,", "    enable: false, // Disabled: XEMS session management is turned off via configuration")
    }
}

// -----------------------------------------------------------------------------
// 2. Server Cluster Topology (xypriss.config.ts)
// -----------------------------------------------------------------------------
if mode == "minimal" {
    // Minimal mode: Strip multiServer configuration completely
    file "xypriss.config.ts" {
        removeUntil("multiServer: {", "};")
        removeLines("auth.server")
        removeLines("api.server")
        removeLines("cdn.server")
    }
} elif cdn == false {
    // Default mode without CDN: Remove cdnServer from cluster registry
    file "xypriss.config.ts" {
        replace("servers: [authServer, mainServer, cdnServer],", "servers: [authServer, mainServer],")
        removeLines("cdn.server")
    }
}
