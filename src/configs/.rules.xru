use std
from "dll" use gArgs::@map{author, xems, mode, cdn}

// =============================================================================
// Module Descriptor: src/configs/.rules.xru
// =============================================================================
// Orchestrates project runtime configurations:
// 1. XEMS Session Management (xemsConfigs.ts):
//    - Toggles the XEMS session engine according to the XEMS flag.
// 2. Server Cluster Topology (xypriss.config.ts & servers.config.ts):
//    - In "minimal" mode: Strips multi-server topology, drops servers.config.ts, and isolates single-app runtime.
//    - When CDN is disabled: Removes CDN server reference from the cluster array.
// =============================================================================


// -----------------------------------------------------------------------------
// 1. XEMS Session Management Configuration
// -----------------------------------------------------------------------------
if xems == false {
    std.println("<yellow>[XEMS: DISABLED]</> Disabling XEMS session engine in xemsConfigs.ts")
    file "xemsConfigs.ts", (doc, err) -> {
        if err != nil { return }
        doc.replaceFuzzy("enable: true,", "enable: false, // Disabled: XEMS session management is turned off via configuration")
    } 
}

// -----------------------------------------------------------------------------
// 2. Server Cluster Topology (xypriss.config.ts & servers.config.ts)
// -----------------------------------------------------------------------------
if mode == "minimal" {
    // Drop multiserver topology configuration file
    drop(["servers.config.ts"])

    // Minimal mode: Strip multiServer configuration completely from xypriss.config.ts
    file "xypriss.config.ts", (doc, err) -> {
        if err != nil { return }
        doc.removeBalanced("multiServer: {", "{", "}")
        doc.removeLines("auth.server")
        doc.removeLines("api.server")
        doc.removeLines("cdn.server")
    }
} elif cdn == false {
    // Default mode without CDN: Remove cdnServer from cluster registry
    file "xypriss.config.ts", (doc, err) -> {
        if err != nil { return }
        doc.replaceFuzzy("servers: [authServer, mainServer, cdnServer],", "servers: [authServer, mainServer],")
        doc.removeLines("cdn.server")
    }
}
