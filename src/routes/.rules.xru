use std
from "root" use main::prune
from "root" use main::cdn
from "root" use main::mode

// =============================================================================
// Module Descriptor: src/routes/.rules.xru
// =============================================================================
// Orchestrates route definition pruning.
// - In "minimal" mode: Drops auth and CDN routes (auth.route.ts, cdn.route.ts).
// - If CDN is disabled: Drops cdn.route.ts while retaining auth.route.ts.
// =============================================================================


prune("route", mode, cdn)
