// Descripteur local : src/routes/.rules.xru
// Gère exclusivement le cycle de vie des routes selon les arguments reçus

#IF {PLUGIN} == true
    // Si c'est un plugin, on ne conserve que la route API essentielle
    Local.Keep(["api.route.ts"])
#END

#IF {MODE} == "minimal"
    Local.Keep(["api.route.ts"])
#END
