use std
from "dll" use gArgs::mode
from "dll" use gArgs::cdn

// =============================================================================
// Module Descriptor: src/const/.rules.xru
// =============================================================================
// Orchestrates global constants and asset configuration paths.
// - In "minimal" mode or when CDN is disabled: Drops cdnPaths.ts.
// =============================================================================


if mode == "minimal" || cdn == false {
    drop(["cdnPaths.ts"])
}
