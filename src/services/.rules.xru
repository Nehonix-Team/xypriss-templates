// =============================================================================
// Module Descriptor: src/services/.rules.xru
// =============================================================================
// Orchestrates service layer modular pruning.
// - In "minimal" mode: Drops auth and CDN services (auth.service.ts, cdn.service.ts).
// - If CDN is disabled: Drops cdn.service.ts while retaining auth.service.ts.
// =============================================================================

arg mode: string = "default"
arg cdn: bool = true

// Invoke global pruning function defined in root main.xru
::PruneModule("service", mode, cdn)
