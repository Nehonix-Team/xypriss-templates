use std
from "root" use main
from "root" use main::mode
from "root" use main::cdn

// =============================================================================
// Module Descriptor: src/controller/.rules.xru
// =============================================================================
// Orchestrates controller layer modular pruning.
// - In "minimal" mode: Drops auth and CDN controllers (auth.controller.ts, cdn.controller.ts).
// - If CDN is disabled: Drops cdn.controller.ts while retaining auth.controller.ts.
// =============================================================================


main::prune("controller", mode, cdn)
