// This file is a configuration file for XyPriss.
// It is automatically loaded by XyPriss when booting up your server.
// For more information, check the documentation at:
// https://xypriss.nehonix.com/docs/config/guide

{
  "$env": {
    "whitelist": [
      "NODE_DISABLE_COLORS",
      // "NO_COLOR",
      "PORT",
      "NODE_ENV",
    ],
  },
  "$vars": {
    "__name__": "&(pkg).name",
    "__description__": "&(pkg).description",
    "__version__": "&(pkg).version",
    "__author__": "&(pkg).author",
    "__PORT__": "&(env).PORT || 8459",
    "__alias__": "&(pkg).alias || app",
    "manifest": {
      "name": "&(this).$vars.__name__",
      "description": "&(this).$vars.__description__",
      "version": "&(this).$vars.__version__",
      "author": "&(this).$vars.__author__",
    },
    "servers": {
      "auth": {
        "port": "&(env).AUTH_SERVER_PORT || 9182",
        "id": "&(env).AUTH_DOMAIN || rest.auth.domain.com",
      },
      "main": {
        "port": "&(env).MAIN_SERVER_PORT || 1822",
        "id": "&(env).MAIN_DOMAIN || rest.api.domain.com",
      },
      "cdn": {
        "port": "&(env).CDN_SERVER_PORT || 5829",
        "id": "&(env).CDN_DOMAIN || rest.cdn.domain.com",
      },
    },
  },
}
