// =============================================================================
// Project Initializer Entrypoint: init.xru
// =============================================================================
// Serves as the primary bootstrapping script for `xfpm init`.
// Resolves latest project bundle from GitHub / cache, unpacks template,
// and invokes root main.xru with CLI flags.
// =============================================================================

mod init

use std
use sig
use fs as Fs
use cmd as Cmd
use sys as Sys
use path as Path
use net as Net

// -----------------------------------------------------------------------------
// 1. REUSE GLOBAL CLI ARGUMENTS (FROM scripts/args.xru VIA dll)
// -----------------------------------------------------------------------------
from "dll" use gArgs::name
from "dll" use gArgs::mode
from "dll" use gArgs::port
from "dll" use gArgs::version
from "dll" use gArgs::description
from "dll" use gArgs::author
from "dll" use gArgs::xems
from "dll" use gArgs::cdn
from "dll" use gArgs::plugin
from "dll" use gArgs::install
from "dll" use gArgs::force
from "dll" use gArgs::server_timeout
from "dmod" use xruV::xruMinVersion
from "dmod" use syos::isWin

// -----------------------------------------------------------------------------
// 2. REUSE NETWORK BUNDLE RESOLVER (FROM scripts/xpackDownload.xru VIA dll)
// -----------------------------------------------------------------------------
from "dll" use XpackD::resolveBundle
from "dll" use orchestrator::@map{exec, type IExecProps}
arg start_server, st: bool = false

Sys.require(">= $f{xruMinVersion}", @map{
    onMismatch: "auto-update",
    mode: "log"
})

let projectName = name
let projectMode = mode
let shouldInstall = install


// -----------------------------------------------------------------------------
// 3. INTERACTIVE SETUP (IF NO CLI ARGUMENTS WERE PROVIDED)
// -----------------------------------------------------------------------------
if !Sys.hasArg() {
    std.println("<cyan>╭─────────────────────────────────────────────────────────────╮</>")
    std.println("<cyan>│</>  <bold>🚀  XyPriss Project Initializer (Interactive)</>              <cyan>│</>")
    std.println("<cyan>╰─────────────────────────────────────────────────────────────╯</>")
    std.println("")

    std::in {
        const inputName = ::input("<cyan>?</> <bold>Project name or directory:</> (my-xypriss-app) ", "my-xypriss-app")
        projectName =: inputName

        const chosenMode = ::select("<cyan>?</> <bold>Select architecture preset:</>", ["default (Enterprise multi-server: Auth, API, CDN, XEMS)", "minimal (Lightweight single-server)"])
        if chosenMode.startsWith("minimal") {
            projectMode =: "minimal"
        } else {
            projectMode =: "default"
        }

        const askInstall = ::confirm("<cyan>?</> <bold>Install dependencies immediately with xfpm?</>", true)
        shouldInstall =: askInstall
    }
    std.println("")
}

// -----------------------------------------------------------------------------
// 4. TARGET DIRECTORY RESOLUTION & VALIDATION
// -----------------------------------------------------------------------------
const targetDir = if projectName.startsWith("/") -> projectName else Path.Join(Sys.cwd(), projectName)

let isInitComplete = false

trap sig::@map{interrupt, terminate} as s {
    if !isInitComplete {
        std.println("\n<red>[CRITICAL:ABORT]</> Process interrupted by <bold>$f{s}</>. Cleaning up...")
        if Fs.exists(targetDir) {
            Fs.remove(targetDir)
            std.println("<yellow>[CLEANUP]</> Removed incomplete directory '<bold>$f{targetDir}</>'")
        }
    }
}

if Fs.exists(targetDir) {
    if force == false {
        std.fatal("Destination directory '$f{targetDir}' already exists. Use --force to overwrite.")
    }
    std.println("<yellow>[CLEANUP]</> Overwriting existing directory '<bold>$f{targetDir}</>'...")
    Fs.remove(targetDir)
}

// -----------------------------------------------------------------------------
// 5. BANNER & INITIALIZATION SUMMARY
// -----------------------------------------------------------------------------
const installStatus = if shouldInstall -> "<green>enabled</>" else "<yellow>disabled</>"

std.println("<cyan>╭─────────────────────────────────────────────────────────────╮</>")
std.println("<cyan>│</>  <bold>🚀  XyPriss Project Initializer</>                               <cyan>│</>")
std.println("<cyan>├─────────────────────────────────────────────────────────────┤</>")
std.println("<cyan>│</>  Target   : <bold>$f{projectName}</>")
std.println("<cyan>│</>  Preset   : <cyan><bold>$f{projectMode}</></>")
std.println("<cyan>│</>  Port     : <bold>$f{port}</>")
std.println("<cyan>│</>  Install  : $f{installStatus}")
std.println("<cyan>╰─────────────────────────────────────────────────────────────╯</>")
std.println("")

// -----------------------------------------------------------------------------
// 6. RESOLVE TEMPLATE XPACK (CACHED OR DOWNLOADED)
// -----------------------------------------------------------------------------
std.println("<cyan><bold>◆ [1/4]</> Resolving template bundle...")
const xpackPath = resolveBundle()

// -----------------------------------------------------------------------------
// 7. UNPACK TEMPLATE INTO TARGET DIRECTORY
// -----------------------------------------------------------------------------
std.println("\n<cyan><bold>◆ [2/4]</> Extracting project template into '<bold>$f{targetDir}</>'...")
Cmd.exec("xru unpack \"$f{xpackPath}\" \"$f{targetDir}\"")
std.println("  <green>✔</> Template unpacked successfully.")

// -----------------------------------------------------------------------------
// 8. EXECUTE PROJECT ORCHESTRATOR (main.xru)
// -----------------------------------------------------------------------------
const cfg: IExecProps= @map{
   targetDir: targetDir,
   projectMode: projectMode,
   projectName: projectName,
   shouldInstall: shouldInstall
}

exec(cfg)
isInitComplete =: true

// -----------------------------------------------------------------------------
// 11. READY INSTRUCTIONS
// -----------------------------------------------------------------------------
std.println("")
std.println("<green>╭─────────────────────────────────────────────────────────────╮</>")
std.println("<green>│</>  <bold>✨  Project initialized successfully!</>                       <green>│</>")
std.println("<green>╰─────────────────────────────────────────────────────────────╯</>")
std.println("")

if !start_server {
    std.println("  <bold>Next steps:</>")
    if projectName != "." && projectName != "./" {
        std.println("    <cyan>→</> cd <bold>$f{projectName}</>")
    }
    if !shouldInstall {
        std.println("    <cyan>→</> 'xfpm install'</>")
    }
    std.println("    <cyan>→</> 'xfpm run dev' <bold>or</> <cyan>'dev'</>")
} else {
    const normalizedPath = Path.join(targetDir)  // removed the second "projectName" param since "targetDir" is already pointed to "projectName"    
    if !shouldInstall {
        std.println("  <yellow>[WARNING]</> Dependencies are not installed. Run <cyan>'xfpm install'</> before starting the dev server.")
        return
    }

    std.println("  <bold>Starting dev server...</>")
    Cmd::exec(if isWin -> "xfpm run dev" else "dev", normalizedPath)
}

std.println("")

