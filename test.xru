use std
use net as Net
use fs as Fs

// ==============================================================================
// 1. DÉCLARATION D'UNE UNITÉ LOCALE AVEC MÉTHODES TYPÉES
// ==============================================================================
unit TemplateManager {
    // 1. Propriétés internes d'instance
    declare baseDir: string = "./src"
    declare isLocked: bool = false
    declare retryLimit: number = 3

    // 2. Méthodes d'instance avec signatures strictes
    // Règle : Toutes les branches de return doivent respecter le type déclaré (-> bool)
    func clean(target: string) -> bool {
        if &isLocked == true {
            std.error("TemplateManager is locked!")
            return false                       // Branche 1 : bool
        }
        std.info("Nettoyage de {&baseDir}/{target}...")
        return true                            // Branche 2 : bool (invalide si return 'test')
    }

    func lock() -> void {
        &isLocked =: true                      // Mutation directe de propriété interne avec =:
        std.warn("TemplateManager verrouillé !")
    }
}

// ==============================================================================
// 2. INSTANCIATION & APPELS DE MÉTHODES TYPÉES
// ==============================================================================
let mgr = @TemplateManager()

// Appel vérifié : nombre et types d'arguments contrôlés statiquement
let success = mgr.clean("cache")
std.println("Résultat du nettoyage : {success}")

mgr.lock()
let blocked = mgr.clean("cache")
std.println("Résultat après verrouillage : {blocked}")

// ==============================================================================
// 3. TÂCHE D'ARRIÈRE-PLAN ASYNCHRONE AVEC 'with'
// ==============================================================================
// 'with' lance immédiatement l'opération en tâche de fond (goroutine Go)
// La syntaxe correcte appelle la méthode cible : with Net.fetch(...)
let downloadTask = with Net.fetch("https://api.github.com/repos/Nehonix-Team/xypriss-templates")

std.info("Téléchargement lancé en arrière-plan...")
std.info("Le script principal continue à s'exécuter en parallèle !")

// Vérification de statut (thread-safe, autocomplété par l'IDE)
let status = downloadTask.isDone()
std.println("Statut immédiat : isDone = {status}")

// Attente et récupération synchrone du résultat
let result = downloadTask.wait()
std.success("Tâche terminée avec succès !")
let status2 = downloadTask.isDone()
std.println("Statut après réponse : isDone = {status2}")
std.println("Taille des données reçues :")
std.println(result)

// ==============================================================================
// 4. MODULE / UNITÉ PERSONNALISÉE AVEC BOUCLE FOR & TÂCHE DE FOND
// ==============================================================================
unit BatchWorker {
    declare batchName: string = "Worker-Alpha"

    // Méthode de calcul lourd simulant un traitement séquentiel par lots
    func processItems(totalItems: number) -> string {
        std.info("[{&batchName}] Traitement en arrière-plan démarré...")
        let sum = 0
        // Support de la nouvelle boucle for avec range (1..totalItems)
        for i in 1..totalItems {
            sum =: sum + i
        }
        return "Lot '{&batchName}' traité avec succès : somme des indices = {sum}"
    }
}

let worker = @BatchWorker()

// Lancement d'une tâche de fond sur une méthode de notre unité personnalisée
let batchTask = with worker.processItems(50)

std.info("Le script principal poursuit ses autres opérations...")
let batchStatusInit = batchTask.isDone()
std.println("Vérification statut tâche Worker : isDone = {batchStatusInit}")

// Récupération typée du résultat
let workerResult = batchTask.wait()
std.success("Résultat : {workerResult}")
let batchStatusFinal = batchTask.isDone()
std.println("Statut final Worker : isDone = {batchStatusFinal}")

