func clean(target: string) -> bool {
        // if r == true {
        //     std.error("Cannot clean: TemplateManager is locked!")
        //     return false
        // }

        Fs.remove("{&baseDir}/target")
        std.warn("Removed {'target'}")
        return true
}
clean("target")

  
