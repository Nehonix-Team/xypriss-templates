use std 
from "services" use (auth, cdn)
from "services" use cdn::deploy
use net as Net

global let a = 1
std.println(a)

const r = cdn.deploy()

if r == true {
    std.println("result: {r}")
} else{
  std.println("false result: {r}")
}


