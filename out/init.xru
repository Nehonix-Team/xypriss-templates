unit s{declare private m: string = "Nehonix-Team/xypriss-templates";declare private n: string = "";declare o: string = "";func p(z){const aa = "Downloading error: $f{z}";s1.fatal(aa)};func q(){const ab = "https://api.github.com/repos/$f{&m}/releases/latest";s1.print("<yellow>[FETCHING]</> Querying latest template release...");let ac = with s2.fetch(ab);while ac.isDone()==false{s1.print("<cyan>.</>");s1.sleep(120ms)};s1.println("");const ad = ac.wait() catch ae;if ae!=nil{&self::p(ae)};const af = s4.parse(ad) catch ag;if ag!=nil{&self::p("Failed to parse metadata JSON: $f{ag}")};&o=:af.tag_name;return ad};func r(){&n=:"$f{s5.homeDir()}/.xfpm/cache";s3.ensureDir(&n);&self::q();if !&o{s1.fatal("Failed to resolve latest template version from GitHub")};const ah = "$f{&n}/project-$f{&o}.xpack";if s3.exists(ah){s1.println("<green>[CACHE]</> Using cached template bundle <bold>$f{&o}</>");return ah};const ai = "https://github.com/$f{&m}/releases/download/$f{&o}/project.xpack";s1.print("<blue>[DOWNLOADING]</> Fetching template bundle <bold>$f{&o}</>...");let aj = with s2.fetch(ai);while aj.isDone()==false{s1.print("<cyan>.</>");s1.sleep(120ms)};s1.println("");const ak = aj.wait() catch al;if al!=nil{&self::p("Failed to download project bundle: $f{al}")};s3.write(ah,ak);s1.println("<green>[SAVED]</> Template bundle cached at '<bold>$f{ah}</>'");return ah}};
