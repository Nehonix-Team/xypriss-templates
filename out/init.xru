use std as s1;
use sig as s2;
use sys as s3;
use net as s4;
use fs as s5;
use json as s6;
use path as s7;
use cmd as s8;
global arg name, n as a: string = "my-xypriss-app";
global arg version, v as b: string = "1.0.0";
global arg description, d as c: string = "Enterprise-grade XyPriss backend service";
global arg author, a as d: string = "";
global arg mode, m as e: string = "default";
global arg xems, x as f: bool = true;
global arg cdn, c as g: bool = true;
global arg plugin as h: bool = false;
global arg install, i as i: bool = true;
global arg port, p as j: number = 7182;
global arg server_timeout, t as k: number = 30000;
global arg force, f as l: bool = false;
arg start_server, st as m: bool = false;

interface orchestrator__IExecProps @map {
    targetDir string;
    projectName string;
    projectMode string;
    shouldInstall bool;
}

unit t {
    declare private n: string = "Nehonix-Team/xypriss-templates";
    declare private o: string = "";
    declare p: string = "";

    func q(aj) {
        const ak = "Downloading error: $f{aj}";
        s1.fatal(ak);
    }

    func r() {
        const al = "https://api.github.com/repos/$f{&n}/releases/latest";
        s1.print("<yellow>[FETCHING]</> Querying latest template release...");
        let am = with s4.fetch(al);
        while am.isDone() == false {
            s1.print("<cyan>.</>");
            s1.sleep(120ms);
        }
        s1.println("");
        const an = am.wait() catch ao;
        if ao != nil {
            &self::q(ao);
        }
        const ap = s6.parse(an) catch aq;
        if aq != nil {
            &self::q("Failed to parse metadata JSON: $f{aq}");
        }
        &p =: ap.tag_name;
        return an;
    }

    func s() {
        &o =: "$f{s3.homeDir()}/.xfpm/cache";
        s5.ensureDir(&o);
        &self::r();
        if !&p {
            s1.fatal("Failed to resolve latest template version from GitHub");
        }
        const ar = "$f{&o}/project-$f{&p}.xpack";
        if s5.exists(ar) {
            s1.println("<green>[CACHE]</> Using cached template bundle <bold>$f{&p}</>");
            return ar;
        }
        const at = "https://github.com/$f{&n}/releases/download/$f{&p}/project.xpack";
        s1.print("<blue>[DOWNLOADING]</> Fetching template bundle <bold>$f{&p}</>...");
        let au = with s4.fetch(at);
        while au.isDone() == false {
            s1.print("<cyan>.</>");
            s1.sleep(120ms);
        }
        s1.println("");
        const av = au.wait() catch aw;
        if aw != nil {
            &self::q("Failed to download project bundle: $f{aw}");
        }
        s5.write(ar, av);
        s1.println("<green>[SAVED]</> Template bundle cached at '<bold>$f{ar}</>'");
        return ar;
    }
}

const u = "2.1.8";
const v = s3.os() == "windows";
const w = s3.os() == "linux";
const x = s3.os() == "macos";
const y = s3.os() == "posix";

func z() {
    let ax = @t();
    return ax.s();
}

func aa(ay) {
    const az = ay.targetDir;
    const ba = ay.projectName;
    const bb = ay.projectMode;
    const bc = ay.shouldInstall;
    const bd = s7.Join(az, "main.xru");
    if !s5.exists(bd) {
        s1.fatal("Critical error: main.xru was not found in destination directory after unpack!");
    }
    const be = s7.Join(az, "fileonix.config.json");
    if s5.exists(be) {
        file be, (bf, bg) -> {
            if bg != nil {
                return;
            }
            bf.setJson("watch", [az]);
        }
    }
    let bh = "xru run \"$f{bd}\" --name=\"$f{ba}\" --mode=\"$f{bb}\" --port=$f{j} --version=\"$f{b}\" --description=\"$f{c}\" --author=\"$f{d}\" --server_timeout=$f{k}";
    if f == false {
        bh =: bh + " --no-xems";
    }
    if g == false {
        bh =: bh + " --no-cdn";
    }
    if h == true {
        bh =: bh + " --plugin";
    }
    if bc == false {
        bh =: bh + " --no-install";
    }
    s1.println("\n<cyan><bold>◆ [3/4]</> Configuring project & running parallel orchestrations...");
    const bi = with s8.exec(bh, az);
    const bj = with s4.isPortBusy(j);
    let bk = 0;
    const bl = if k > 0 -> k else 120000;
    while !bi.isDone() {
        s1.sleep(500ms);
        bk =: bk + 500;
        if bk >= bl {
            s1.println("\n<red>[TIMEOUT]</> Template orchestration exceeded timeout limit ($f{bl}ms).");
            bi.cancel();
            break
        }
    }
    bi.wait() catch bm;
    if bm != nil {
        s1.fatal("Template orchestration failed: $f{bm}");
    }
    s1.println("  <green>✔</> Environment & presets configured.");
    const bn = s7.Join(az, ".git");
    if !s5.exists(bn) {
        const bo = "master";
        const bp = if d != "" -> "by $f{d}" else ".";
        const bq = s8.exec("git init", az) catch nil;
        if bq != nil {
            s8.exec("git add .", az) catch nil;
            s8.exec("git commit -m \"Initial commit from xfpm init $f{bp}\"", az) catch nil;
            s8.exec("git branch -M $f{bo}", az) catch nil;
            s1.println("  <green>✔</> Git repository initialized.");
        }
    }
    s1.println("\n<cyan><bold>◆ [4/4]</> Validating network environment...");
    const br = bj.wait() catch or false;
    if br {
        s1.println("  <yellow>▲ [WARN]</> Port <bold>$f{j}</> is currently in use on localhost.");
        s1.println("  <yellow>▲ [WARN]</> You may want to configure a different port before launching.");
    } else {
        s1.println("  <green>✔</> Port <bold>$f{j}</> is free and available.");
    }
}

s3.require(">= 2.1.8", @map {
    onMismatch: "auto-update", mode: "log"
}
);
let ab = a;
let ac = e;
let ad = i;
if !s3.hasArg() {
    s1.println("<cyan>╭─────────────────────────────────────────────────────────────╮</>");
    s1.println("<cyan>│</>  <bold>🚀  XyPriss Project Initializer (Interactive)</>              <cyan>│</>");
    s1.println("<cyan>╰─────────────────────────────────────────────────────────────╯</>");
    s1.println("");
    s1::in {
        const bs = ::input("<cyan>?</> <bold>Project name or directory:</> (my-xypriss-app) ", "my-xypriss-app");
        ab =: bs;
        const bt = ::select("<cyan>?</> <bold>Select architecture preset:</>", ["default (Enterprise multi-server: Auth, API, CDN, XEMS)", "minimal (Lightweight single-server)"]);
        if bt.startsWith("minimal") {
            ac =: "minimal";
        } else {
            ac =: "default";
        };
        const bu = ::confirm("<cyan>?</> <bold>Install dependencies immediately with xfpm?</>", true);
        ad =: bu;
    }
    s1.println("");
}
const ae = if ab.startsWith("/") -> ab else s7.Join(s3.cwd(), ab);
let af = false;
trap s2::@map{interrupt, terminate} as s {
    if !af {
        s1.println("\n<red>[CRITICAL:ABORT]</> Process interrupted by <bold>$f{s}</>. Cleaning up...");
        if s5.exists(ae) {
            s5.remove(ae);
            s1.println("<yellow>[CLEANUP]</> Removed incomplete directory '<bold>$f{ae}</>'");
        }
    }
}
if s5.exists(ae) {
    if l == false {
        s1.fatal("Destination directory '$f{ae}' already exists. Use --force to overwrite.");
    }
    s1.println("<yellow>[CLEANUP]</> Overwriting existing directory '<bold>$f{ae}</>'...");
    s5.remove(ae);
}
const ag = if ad -> "<green>enabled</>" else "<yellow>disabled</>";
s1.println("<cyan>╭─────────────────────────────────────────────────────────────╮</>");
s1.println("<cyan>│</>  <bold>🚀  XyPriss Project Initializer</>                               <cyan>│</>");
s1.println("<cyan>├─────────────────────────────────────────────────────────────┤</>");
s1.println("<cyan>│</>  Target   : <bold>$f{ab}</>");
s1.println("<cyan>│</>  Preset   : <cyan><bold>$f{ac}</></>");
s1.println("<cyan>│</>  Port     : <bold>$f{j}</>");
s1.println("<cyan>│</>  Install  : $f{ag}");
s1.println("<cyan>╰─────────────────────────────────────────────────────────────╯</>");
s1.println("");
s1.println("<cyan><bold>◆ [1/4]</> Resolving template bundle...");
const ah = z();
s1.println("\n<cyan><bold>◆ [2/4]</> Extracting project template into '<bold>$f{ae}</>'...");
s8.exec("xru unpack \"$f{ah}\" \"$f{ae}\"");
s1.println("  <green>✔</> Template unpacked successfully.");
const ai = @map {
    targetDir: ae, projectMode: ac, projectName: ab, shouldInstall: ad
};
aa(ai);
af =: true;
s1.println("");
s1.println("<green>╭─────────────────────────────────────────────────────────────╮</>");
s1.println("<green>│</>  <bold>✨  Project initialized successfully!</>                       <green>│</>");
s1.println("<green>╰─────────────────────────────────────────────────────────────╯</>");
s1.println("");
if !m {
    s1.println("  <bold>Next steps:</>");
    if ab != "." && ab != "./" {
        s1.println("    <cyan>→</> cd <bold>$f{ab}</>");
    }
    s1.println("    <cyan>→</> 'xfpm run dev' <bold>or</> <cyan>'dev'</>");
} else {
    const bv = s7.join(ae);
    if i == false {
        s1.println("  <bold>Run</>");
    }
    s1.println("  <bold>Starting dev server...</>");
    s8.exec(if v -> "xfpm run dev" else "dev", bv)
};
s1.println("");
