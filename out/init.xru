unit t {
    declare private n: string = "Nehonix-Team/xypriss-templates";
    declare private o: string = "";
    declare p: string = "";

    func q(ae) {
        const af = "Downloading error: $f{ae}";
        s1.fatal(af);
    }

    func r() {
        const ag = "https://api.github.com/repos/$f{&n}/releases/latest";
        s1.print("<yellow>[FETCHING]</> Querying latest template release...");
        let ah = with s3.fetch(ag);
        while ah.isDone() == false {
            s1.print("<cyan>.</>");
            s1.sleep(120ms);
        }
        s1.println("");
        const ai = ah.wait() catch aj;
        if aj != nil {
            &self::q(aj);
        }
        const ak = s5.parse(ai) catch al;
        if al != nil {
            &self::q("Failed to parse metadata JSON: $f{al}");
        }
        &p =: ak.tag_name;
        return ai;
    }

    func s() {
        &o =: "$f{s6.homeDir()}/.xfpm/cache";
        s4.ensureDir(&o);
        &self::r();
        if !&p {
            s1.fatal("Failed to resolve latest template version from GitHub");
        }
        const am = "$f{&o}/project-$f{&p}.xpack";
        if s4.exists(am) {
            s1.println("<green>[CACHE]</> Using cached template bundle <bold>$f{&p}</>");
            return am;
        }
        const an = "https://github.com/$f{&n}/releases/download/$f{&p}/project.xpack";
        s1.print("<blue>[DOWNLOADING]</> Fetching template bundle <bold>$f{&p}</>...");
        let ao = with s3.fetch(an);
        while ao.isDone() == false {
            s1.print("<cyan>.</>");
            s1.sleep(120ms);
        }
        s1.println("");
        const ap = ao.wait() catch aq;
        if aq != nil {
            &self::q("Failed to download project bundle: $f{aq}");
        }
        s4.write(am, ap);
        s1.println("<green>[SAVED]</> Template bundle cached at '<bold>$f{am}</>'");
        return am;
    }
}

const u = "2.1.8";

func v() {
    let ar = @t();
    return ar.s();
}

func w(at) {
    const au = at.targetDir;
    const av = at.projectName;
    const aw = at.projectMode;
    const ax = at.shouldInstall;
    const ay = s7.Join(au, "main.xru");
    if !s4.exists(ay) {
        s1.fatal("Critical error: main.xru was not found in destination directory after unpack!");
    }
    const az = s7.Join(au, "fileonix.config.json");
    if s4.exists(az) {
        file az, (ba, bb) -> {
            if bb != nil {
                return;
            }
            ba.setJson("watch", [au]);
        }
    }
    let bc = "xru run \"$f{ay}\" --name=\"$f{av}\" --mode=\"$f{aw}\" --port=$f{j} --version=\"$f{b}\" --description=\"$f{c}\" --author=\"$f{d}\" --server_timeout=$f{k}";
    if f == false {
        bc =: bc + " --no-xems";
    }
    if g == false {
        bc =: bc + " --no-cdn";
    }
    if h == true {
        bc =: bc + " --plugin";
    }
    if ax == false {
        bc =: bc + " --no-install";
    }
    s1.println("\n<cyan><bold>◆ [3/4]</> Configuring project & running parallel orchestrations...");
    const bd = with s8.exec(bc, au);
    const be = with s3.isPortBusy(j);
    let bf = 0;
    const bg = if k > 0 -> k else 120000;
    while !bd.isDone() {
        s1.sleep(500ms);
        bf =: bf + 500;
        if bf >= bg {
            s1.println("\n<red>[TIMEOUT]</> Template orchestration exceeded timeout limit ($f{bg}ms).");
            bd.cancel();
            break
        }
    }
    bd.wait() catch bh;
    if bh != nil {
        s1.fatal("Template orchestration failed: $f{bh}");
    }
    s1.println("  <green>✔</> Environment & presets configured.");
    const bi = s7.Join(au, ".git");
    if !s4.exists(bi) {
        const bj = "master";
        const bk = if d != "" -> "by $f{d}" else ".";
        const bl = s8.exec("git init", au) catch nil;
        if bl != nil {
            s8.exec("git add .", au) catch nil;
            s8.exec("git commit -m \"Initial commit from xfpm init $f{bk}\"", au) catch nil;
            s8.exec("git branch -M $f{bj}", au) catch nil;
            s1.println("  <green>✔</> Git repository initialized.");
        }
    }
    s1.println("\n<cyan><bold>◆ [4/4]</> Validating network environment...");
    const bm = be.wait() catch or false;
    if bm {
        s1.println("  <yellow>▲ [WARN]</> Port <bold>$f{j}</> is currently in use on localhost.");
        s1.println("  <yellow>▲ [WARN]</> You may want to configure a different port before launching.");
    } else {
        s1.println("  <green>✔</> Port <bold>$f{j}</> is free and available.");
    }
}

s6.require(">= 2.1.8", @map {
