unit z{declare private p: string = "Nehonix-Team/xypriss-templates";declare private q: string = "";declare private r: string = "";declare private s: string = "";declare t: string = "";func u(av){const aw = "Downloading error: $f{av}";s3.fatal(aw)};func v(){const ax = "https://api.github.com/repos/$f{&p}/releases/latest";s3.print("<yellow>[FETCHING]</> Querying latest template release...");let ay = with s7.fetch(ax);while ay.isDone()==false{s3.print("<cyan>.</>");s3.sleep(120ms)};s3.println("");const az = ay.wait() catch ba;if ba!=nil{&self::u(ba)};const bb = s8.parse(az) catch bc;if bc!=nil{&self::u("Failed to parse metadata JSON: $f{bc}")};&r=:az;&t=:bb.tag_name;return az};func w(){const bd = "https://github.com/$f{&p}/releases/download/$f{&t}/project.xpack.sha256";let be = with s7.fetch(bd);while be.isDone()==false{s3.sleep(40ms)};const bf = be.wait() catch bg;if bg==nil&&bf!=""{let bh = bf.trim();if bh.contains(" "){let bi = bh.split(" ");bh=:bi.get(0).trim()};if bh.len()>=64{&s=:bh.slice(0,64);return &s}};if &r!=""{const bj = s8.parse(&r) catch nil;if bj!=nil&&bj.body!=nil{let bk = bj.body;if bk.contains("sha256")||bk.contains("SHA256"){let bl = bk.split("\n");for bm in bl{let bn = bm.trim();if bn.toLower().contains("sha256")&&bn.contains(":"){let bo = bn.split(":");if bo.len()>=2{let bp = bo.get(1).trim();if bp.len()>=64{&s=:bp.slice(0,64);return &s}}}}}}};return ""};func x(bq,br){if !s1.exists(bq){return false};const bs = s9.fileSha256(bq) catch bt;if bt!=nil||bs==""{s3.println("<red>[SECURITY:ERROR]</> Failed to compute SHA-256 for '$f{bq}'");return false};if br!=""{const bu = s9.verify(bs,br);if !bu{s3.println("<red>[INTEGRITY:ERROR]</> Checksum mismatch for template bundle!");s3.println("  Expected : <yellow>$f{br}</>");s3.println("  Received : <red>$f{bs}</>");s1.remove(bq);return false};s3.println("<green>[VERIFIED]</> Checksum verified successfully (SHA-256: <bold>$f{bs.slice(0, 16)}...</>)")} else{s3.println("<cyan>[INTEGRITY]</> Template bundle SHA-256