func ah(cx){const cy = cx.targetDir;const cz = cx.projectName;const da = cx.projectMode;const db = cx.shouldInstall;const dc = cx.projectDb;const dd = s6.Join(cy,"main.xru");if !s1.exists(dd){s3.fatal("Critical error: main.xru was not found in destination directory after unpack!")};const de = s6.Join(cy,"xfpm.resolve.lock");if s1.exists(de){s1.remove(de)};const df = s6.Join(cy,"fileonix.config.json");if s1.exists(df){file df,(dg,dh)->{if dh!=nil{return};dg.setJson("watch",[cy])}};let di = "xru run \"$f{dd}\" --name=\"$f{cz}\" --mode=\"$f{da}\" --port=$f{j} --version=\"$f{b}\" --server_timeout=$f{k} --database=\"$f{dc}\"";if c!=""&&c!="Enterprise-grade XyPriss backend service"{di=:di+" --description=\"$f{c}\""};if d!=""{di=:di+" --author=\"$f{d}\""};if f==true{di=:di+" --xems"} else{di=:di+" --no-xems"};if g==true{di=:di+" --cdn"} else{di=:di+" --no-cdn"};if h==true{di=:di+" --plugin"};if db==true{di=:di+" --install"} else{di=:di+" --no-install"};if cx.yes==true{di=:di+" --yes"};s3.println("\n<cyan><bold>◆ [3/4]</> Configuring project & running parallel orchestrations...");const dj = with s2.exec(di,cy);const dk = with s7.isPortBusy(j);let dl = 0;const dm = if db -> 300000 else 60000;const dn = if k>30000 -> k else dm;while !dj.isDone(){s3.sleep(500ms);dl=:dl+500;if dl>=dn{s3.println("\n<red>[TIMEOUT]</> Template orchestration exceeded timeout limit ($f{dn}ms).");dj.cancel();break}};dj.wait() catch do;if do!=nil{s3.fatal("Template orchestration failed: $f{do}")};s3.println("  <green>✔</> Environment & presets configured.");const dp = s6.Join(cy,".git");if !s1.exists(dp){const dq = s6.Join(cy,".gitignore");file dq,(dr,ds)->{if ds!=nil{return};dr.append("\n# Environment variables & secrets\n.env\n.env.*\n.env.local\n.env.remote\n.storage.xems\n")};const dt = "master";const du = if d!="" -> "by $f{d}" else ".";cout s2::@map{dir:cy,out,err} as c{::exec("git init");::exec("git add .");::exec("git reset HEAD .env");::exec("git commit -m \"Initial commit from xfpm init $f{d