if !o{s3.println("  <bold>Next steps:</>");if ai!="."&&ai!="./"{s3.println("    <cyan>→</> cd <bold>$f{ai}</>")};if !al{s3.println("    <cyan>→</> 'xfpm install'</>")};if ak=="prisma"{s3.println("    <cyan>→</> 'xfpmx prisma db push' <bold>(sync schema to database)</>")} elif ak=="drizzle"{s3.println("    <cyan>→</> 'xfpmx drizzle-kit push' <bold>(sync schema to database)</>")};s3.println("    <cyan>→</> 'xfpm run dev' <bold>or</> <cyan>'dev'</>")} else{const ei = s6.join(ap);if !al{s3.println("  <yellow>[WARNING]</> Dependencies are not installed. Run <cyan>'xfpm install'</> before starting the dev server.");return};s3.println("  <bold>Starting dev server...</>");s2.exec(if ab -> "xfpm run dev" else "dev",ei)};
