use std as s1;
use sig as s2;
use sys as s3;
use net as s4;
use fs as s5;
use json as s6;
use crypto as s7;
use path as s8;
use cmd as s9;
global arg name, n as a: string = "my-xypriss-app";
global arg version, v as b: string = "1.0.0";
global arg description, d as c: string = "Enterprise-grade XyPriss backend service";
global arg author, a as d: string = "";
global arg mode, m as e: "default" or "minimal" = "default";
global arg xems, x as f: bool = true;
global arg cdn, c as g: bool = true;
global arg plugin as h: bool = false;
global arg install, i as i: bool = false;
global arg port, p as j: number = 7182;
global arg server_timeout, t as k: number = 30000;
global arg force, f as l: bool = false;
global arg yes, y as m: bool = false;
global arg database, db as n: "none" or "drizzle" or "prisma" or "postgresql" = "none";
arg start_server, st as o: bool = false;

interface orchestrator__IExecProps @map {
    targetDir string;
    projectName string;
    projectMode string;
    shouldInstall bool;
    projectDb string;
    yes bool;
}

unit z {
    declare private p: string = "Nehonix-Team/xypriss-templates";
    declare private q: string = "";
    declare private r: string = "";
    declare private s: string = "";
    declare t: string = "";

    func u(av) {
        const aw = "Downloading error: $f{av}";
        s1.fatal(aw);
    }

    func v() {
        const ax = "https://api.github.com/repos/$f{&p}/releases/latest";
        s1.print("<yellow>[FETCHING]</> Querying latest template release...");
        let ay = with s4.fetch(ax);
        while ay.isDone() == false {
            s1.print("<cyan>.</>");
            s1.sleep(120ms);
        }
        s1.println("");
        const az = ay.wait() catch ba;
        if ba != nil {
            &self::u(ba);
        }
        const bb = s6.parse(az) catch bc;
        if bc != nil {
            &self::u("Failed to parse metadata JSON: $f{bc}");
        }
        &r =: az;
        &t =: bb.tag_name;
        return az;
    }

    func w() {
        const bd = "https://github.com/$f{&p}/releases/download/$f{&t}/project.xpack.sha256";
        let be = with s4.fetch(bd);
        while be.isDone() == false {
            s1.sleep(40ms);
        }
        const bf = be.wait() catch bg;
        if bg == nil && bf != "" {
            let bh = bf.trim();
            if bh.contains(" ") {
                let bi = bh.split(" ");
                bh =: bi.get(0).trim();
            }
            if bh.len() >= 64 {
                &s =: bh.slice(0, 64);
                return&s;
            }
        }
        if&r != "" {
            const bj = s6.parse(&r) catch nil;
            if bj != nil && bj.body != nil {
                let bk = bj.body;
                if bk.contains("sha256") || bk.contains("SHA256") {
                    let bl = bk.split("\n");
                    for bm in bl {
                        let bn = bm.trim();
                        if bn.toLower().contains("sha256") && bn.contains(":") {
                            let bo = bn.split(":");
                            if bo.len() >= 2 {
                                let bp = bo.get(1).trim();
                                if bp.len() >= 64 {
                                    &s =: bp.slice(0, 64);
                                    return&s;
                                }
                            }
                        }
                    }
                }
            }
        }
        return "";
    }

    func x(bq, br) {
        if !s5.exists(bq) {
            return false;
        }
        const bs = s7.fileSha256(bq) catch bt;
        if bt != nil || bs == "" {
            s1.println("<red>[SECURITY:ERROR]</> Failed to compute SHA-256 for '$f{bq}'");
            return false;
        }
        if br != "" {
            const bu = s7.verify(bs, br);
            if !bu {
                s1.println("<red>[INTEGRITY:ERROR]</> Checksum mismatch for template bundle!");
                s1.println("  Expected : <yellow>$f{br}</>");
                s1.println("  Received : <red>$f{bs}</>");
                s5.remove(bq);
                return false;
            }
            s1.println("<green>[VERIFIED]</> Checksum verified successfully (SHA-256: <bold>$f{bs.slice(0, 16)}...</>)");
        } else {
            s1.println("<cyan>[INTEGRITY]</> Template bundle SHA-256: <bold>$f{bs}</>");
        };
        const bv = "$f{bq}.sha256";
        s5.write(bv, bs);
        return true;
    }

    func y() {
        if s5.exists("out/project.xpack") {
            s1.println("<green>[LOCAL]</> Using local template bundle <bold>out/project.xpack</>");
            return "out/project.xpack";
        }
        &q =: s8.Join(s3.homeDir(), ".xfpm", "cache");
        s5.ensureDir(&q);
        &self::v();
        if !&t {
            s1.fatal("Failed to resolve latest template version from GitHub");
        }
        &self::w();
        const bw = s8.Join(&q, "project-$f{&t}.xpack");
        const bx = "$f{bw}.sha256";
        if s5.exists(bw) {
            let bz = &s;
            if bz == "" && s5.exists(bx) {
                bz =: s5.read(bx).trim();
            }
            if bz != "" {
                const ca = s7.verifyFile(bw, bz);
                if ca {
                    s1.println("<green>[CACHE]</> Using verified cached template bundle <bold>$f{&t}</>");
                    return bw;
                }
                s1.println("<yellow>[WARN]</> Cached template bundle failed integrity verification. Purging corrupt cache...");
                s5.remove(bw);
                if s5.exists(bx) {
                    s5.remove(bx);
                }
            } else {
                s1.println("<green>[CACHE]</> Using cached template bundle <bold>$f{&t}</>");
                return bw;
            }
        }
        const cb = "https://github.com/$f{&p}/releases/download/$f{&t}/project.xpack";
        s1.print("<blue>[DOWNLOADING]</> Fetching template bundle <bold>$f{&t}</>...");
        let cc = with s4.fetch(cb);
        while cc.isDone() == false {
            s1.print("<cyan>.</>");
            s1.sleep(120ms);
        }
        s1.println("");
        const cd = cc.wait() catch ce;
        if ce != nil {
            &self::u("Failed to download project bundle: $f{ce}");
        }
        s5.write(bw, cd);
        const cf = &self::x(bw, &s);
        if !cf && &s != "" {
            s1.fatal("Aborting initialization: Downloaded template bundle is corrupted or compromised.");
        }
        s1.println("<green>[SAVED]</> Template bundle cached at '<bold>$f{bw}</>'");
        return bw;
    }
}

const aa = "2.1.13";
const ab = s3.os() == "windows";
const ac = s3.os() == "linux";
const ad = s3.os() == "macos";
const ae = s3.os() == "posix";

func af() {
    if s5.exists("out/project.xpack") {
        s1.println("<green>[LOCAL]</> Using local template bundle <bold>out/project.xpack</>");
        return "out/project.xpack";
    }
    let cg = @z();
    return cg.y();
}

func ag(ch) {
    const ci = ch.targetDir;
    const cj = ch.projectName;
    const ck = ch.projectMode;
    const cl = ch.shouldInstall;
    const cm = ch.projectDb;
    const cn = s8.Join(ci, "main.xru");
    if !s5.exists(cn) {
        s1.fatal("Critical error: main.xru was not found in destination directory after unpack!");
    }
    const co = s8.Join(ci, "xfpm.resolve.lock");
    if s5.exists(co) {
        s5.remove(co);
    }
    const cp = s8.Join(ci, "fileonix.config.json");
    if s5.exists(cp) {
        file cp, (cq, cr) -> {
            if cr != nil {
                return;
            }
            cq.setJson("watch", [ci]);
        }
    }
    let cs = "xru run \"$f{cn}\" --name=\"$f{cj}\" --mode=\"$f{ck}\" --port=$f{j} --version=\"$f{b}\" --server_timeout=$f{k} --database=\"$f{cm}\"";
    if c != "" && c != "Enterprise-grade XyPriss backend service" {
        cs =: cs + " --description=\"$f{c}\"";
    }
    if d != "" {
        cs =: cs + " --author=\"$f{d}\"";
    }
    if f == true {
        cs =: cs + " --xems";
    } else {
        cs =: cs + " --no-xems";
    };
    if g == true {
        cs =: cs + " --cdn";
    } else {
        cs =: cs + " --no-cdn";
    };
    if h == true {
        cs =: cs + " --plugin";
    }
    if cl == true {
        cs =: cs + " --install";
    } else {
        cs =: cs + " --no-install";
    };
    if ch.yes == true {
        cs =: cs + " --yes";
    }
    s1.println("\n<cyan><bold>◆ [3/4]</> Configuring project & running parallel orchestrations...");
    const ct = with s9.exec(cs, ci);
    const cu = with s4.isPortBusy(j);
    let cv = 0;
    const cw = if cl -> 300000 else 60000;
    const cx = if k > 30000 -> k else cw;
    while !ct.isDone() {
        s1.sleep(500ms);
        cv =: cv + 500;
        if cv >= cx {
            s1.println("\n<red>[TIMEOUT]</> Template orchestration exceeded timeout limit ($f{cx}ms).");
            ct.cancel();
            break
        }
    }
    ct.wait() catch cy;
    if cy != nil {
        s1.fatal("Template orchestration failed: $f{cy}");
    }
    s1.println("  <green>✔</> Environment & presets configured.");
    const cz = s8.Join(ci, ".git");
    if !s5.exists(cz) {
        const da = s8.Join(ci, ".gitignore");
        file da, (db, dc) -> {
            if dc != nil {
                return;
            }
            db.append("\n# Environment variables & secrets\n.env\n.env.*\n.env.local\n.env.remote\n.storage.xems\n");
        }
        const dd = "master";
        const de = if d != "" -> "by $f{d}" else ".";
        cout s9::@map{dir : ci, out, err} as c {
            ::exec("git init");
            ::exec("git add .");
            ::exec("git reset HEAD .env");
            ::exec("git commit -m \"Initial commit from xfpm init $f{de}\"");
            ::exec("git branch -M $f{dd}");
        }
        if c.ok {
            s1.println("  <green>✔</> Git repository initialized.");
        }
    }
    s1.println("\n<cyan><bold>◆ [4/4]</> Validating network environment...");
    const df = cu.wait() catch or false;
    if df {
        s1.println("  <yellow>▲ [WARN]</> Port <bold>$f{j}</> is currently in use on localhost.");
        s1.println("  <yellow>▲ [WARN]</> You may want to configure a different port before launching.");
    } else {
        s1.println("  <green>✔</> Port <bold>$f{j}</> is free and available.");
    }
}

func ah() {
    const dg = s3.os() == "windows";
    const dh = if dg -> "bun.exe" else "bun";
    const di = s8.Join(s3.homeDir(), ".xfpm", "bin", dh);
    if s5.exists(di) {
        return true;
    }
    const dj = s8.Join(s3.homeDir(), ".bun", "bin", dh);
    if s5.exists(dj) {
        return true;
    }
    const dk = s9.exec("bun --version") catch dl;
    if dk != nil && dk.trim() != "" {
        return true;
    }
    const dm = s9.exec("xfpm list -g bun") catch dn;
    if dm != nil && dm.contains("[PACKAGE] bun") {
        return true;
    }
    return false;
}

s3.require(">= 2.1.13", @map {
    onMismatch: "auto-update", mode: "log"
}
);
let ai = a;
let aj = e;
let ak = n;
let al = i;
let am = l;
let an = m;
let ao = false;
for do in s3.args() {
    const dp = do.trim();
    if dp != "-f" && dp != "--force" && !dp.startsWith("-f=") && !dp.startsWith("--force=") && dp != "-y" && dp != "--yes" && !dp.startsWith("-y=") && !dp.startsWith("--yes=") {
        ao =: true;
        break
    }
}
if an {
    am =: true;
}
if !ao && !an {
    s1.println("<cyan>╭─────────────────────────────────────────────────────────────╮</>");
    s1.println("<cyan>│</>  <bold>🚀  XyPriss Project Initializer (Interactive)</>              <cyan>│</>");
    s1.println("<cyan>╰─────────────────────────────────────────────────────────────╯</>");
    s1.println("");
    s1::in {
        const dq = ::input("<cyan>?</> <bold>Project name or directory:</> (my-xypriss-app) ", "my-xypriss-app");
        ai =: dq;
        const dr = if dq.startsWith("/") -> dq else s8.Join(s3.cwd(), dq);
        if s5.exists(dr) && !am {
            const ds = ::confirm("<yellow>?</> <bold>Target directory '$f{dq}' already exists. Overwrite?</>", false);
            if !ds {
                s1.println("<red>[ABORT]</> Destination directory already exists. Setup aborted.");
                s3.exit(1);
            }
            am =: true;
        }
        const dt = ::select("<cyan>?</> <bold>Select architecture preset:</>", ["default (Enterprise multi-server: Auth, API, CDN, XEMS)", "minimal (Lightweight single-server)"]);
        if dt.startsWith("minimal") {
            aj =: "minimal";
        } else {
            aj =: "default";
        };
        const du = ::select("<cyan>?</> <bold>Select database / ORM provider:</>", ["none (No database - default)", "drizzle (Drizzle ORM with PostgreSQL - Recommended)", "prisma (Prisma ORM v7 with PostgreSQL)"]);
        if du.startsWith("drizzle") {
            ak =: "drizzle";
        } elif du.startsWith("prisma") {
            ak =: "prisma";
        } else {
            ak =: "none";
        };
        const dv = ::confirm("<cyan>?</> <bold>Install dependencies immediately with xfpm?</>", true);
        al =: dv;
    }
    s1.println("");
}
const ap = if s8.IsAbs(ai) -> ai else s8.Join(s3.cwd(), ai);
let aq = false;
trap s2::@map{interrupt, terminate} as s {
    if !aq {
        s1.println("\n<red>[CRITICAL:ABORT]</> Process interrupted by <bold>$f{s}</>. Cleaning up...");
        if s5.exists(ap) {
            s5.remove(ap);
            s1.println("<yellow>[CLEANUP]</> Removed incomplete directory '<bold>$f{ap}</>'");
        }
    }
}
if s5.exists(ap) {
    if am == false {
        s1.fatal("Destination directory '$f{ap}' already exists. Use --force to overwrite.");
    }
    s1.println("<yellow>[CLEANUP]</> Overwriting existing directory '<bold>$f{ap}</>'...");
    s5.remove(ap);
}
const ar = if al -> "<green>enabled</>" else "<yellow>disabled</>";
s1.println("<cyan>╭─────────────────────────────────────────────────────────────╮</>");
s1.println("<cyan>│</>  <bold>🚀  XyPriss Project Initializer</>                               <cyan>│</>");
s1.println("<cyan>├─────────────────────────────────────────────────────────────┤</>");
s1.println("<cyan>│</>  Target   : <bold>$f{ai}</>");
s1.println("<cyan>│</>  Preset   : <cyan><bold>$f{aj}</></>");
s1.println("<cyan>│</>  Database : <yellow><bold>$f{ak}</></>");
s1.println("<cyan>│</>  Port     : <bold>$f{j}</>");
s1.println("<cyan>│</>  Install  : $f{ar}");
s1.println("<cyan>╰─────────────────────────────────────────────────────────────╯</>");
s1.println("");
if al == true && !ah() {
    s1.println("<yellow>[RUNTIME]</> XyPriss requires the <bold>Bun runtime</> to execute scripts and servers.");
    let dw = false;
    if an {
        dw =: true;
    } else {
        s1::in {
            dw =: ::confirm("<cyan>?</> <bold>Would you like to install Bun globally now with 'xfpm i -g bun'?</>", true);
        }
    };
    if dw {
        s1.println("<cyan>[RUNTIME]</> Bootstrapping Bun runtime via <bold>xfpm i -g bun</>...");
        s9.exec("xfpm i -g bun") catch dx;
        if dx != nil {
            s1.println("<yellow>[WARNING]</> Failed to auto-install Bun: $f{dx}");
            s1.println("<yellow>[HINT]</> You can install it later with 'xfpm i -g bun'.");
        } else {
            s1.println("  <green>✔</> Bun runtime integrated successfully.");
        }
    } else {
        s1.println("<yellow>[WARNING]</> Bun runtime installation skipped. Run 'xfpm i -g bun' manually if needed.");
    };
    s1.println("");
}
s1.println("<cyan><bold>◆ [1/4]</> Resolving template bundle...");
const at = af();
s1.println("\n<cyan><bold>◆ [2/4]</> Extracting project template into '<bold>$f{ap}</>'...");
s9.exec("xru unpack \"$f{at}\" \"$f{ap}\"");
s1.println("  <green>✔</> Template unpacked successfully.");
const au = @map {
    targetDir: ap, projectMode: aj, projectName: ai, shouldInstall: al, projectDb: ak, yes: an
};
ag(au);
aq =: true;
s1.println("");
s1.println("<green>╭─────────────────────────────────────────────────────────────╮</>");
s1.println("<green>│</>  <bold>✨  Project initialized successfully!</>                       <green>│</>");
s1.println("<green>╰─────────────────────────────────────────────────────────────╯</>");
s1.println("");
if !o {
    s1.println("  <bold>Next steps:</>");
    if ai != "." && ai != "./" {
        s1.println("    <cyan>→</> cd <bold>$f{ai}</>");
    }
    if !al {
        s1.println("    <cyan>→</> 'xfpm install'</>");
    }
    if ak == "prisma" {
        s1.println("    <cyan>→</> 'xfpmx prisma db push' <bold>(sync schema to database)</>");
    } elif ak == "drizzle" {
        s1.println("    <cyan>→</> 'xfpmx drizzle-kit push' <bold>(sync schema to database)</>");
    };
    s1.println("    <cyan>→</> 'xfpm run dev' <bold>or</> <cyan>'dev'</>");
} else {
    const dy = s8.join(ap);
    if !al {
        s1.println("  <yellow>[WARNING]</> Dependencies are not installed. Run <cyan>'xfpm install'</> before starting the dev server.");
        return;
    }
    s1.println("  <bold>Starting dev server...</>");
    s9.exec(if ab -> "xfpm run dev" else "dev", dy)
};
s1.println("");
