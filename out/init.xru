const ac = v();
s1.println("\n<cyan><bold>◆ [2/4]</> Extracting project template into '<bold>$f{aa}</>'...");
s8.exec("xru unpack \"$f{ac}\" \"$f{aa}\"");
s1.println("  <green>✔</> Template unpacked successfully.");
const ad = @map {
