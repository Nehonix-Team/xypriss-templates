use std as s1;
use sig as s2;
use sys as s3;
use net as s4;
use fs as s5;
use json as s6;
use crypto as s7;
use path as s8;
use cmd as s9;
global arg name, n as a: string = "my-xypriss-app";
global arg version, v as b: string = "1.0.0";
global arg description, d as c: string = "Enterprise-grade XyPriss backend service";
global arg author, a as d: string = "";
global arg mode, m as e: "default" or "minimal" = "default";
global arg xems, x as f: bool = true;
global arg cdn, c as g: bool = true;
global arg plugin as h: bool = false;
global arg install, i as i: bool = false;
global arg port, p as j: number = 7182;
global arg server_timeout, t as k: number = 30000;
global arg force, f as l: bool = false;
global arg database, db as m: "none" or "prisma" or "drizzle" or "postgresql" = "none";
arg start_server, st as n: bool = false;

interface orchestrator__IExecProps @map {
    targetDir string;
    projectName string;
    projectMode string;
    shouldInstall bool;
    projectDb string;
}

unit y {
    declare private o: string = "Nehonix-Team/xypriss-templates";
    declare private p: string = "";
    declare private q: string = "";
    declare private r: string = "";
    declare s: string = "";

    func t(ap) {
        const aq = "Downloading error: $f{ap}";
        s1.fatal(aq);
    }

    func u() {
        const ar = "https://api.github.com/repos/$f{&o}/releases/latest";
        s1.print("<yellow>[FETCHING]</> Querying latest template release...");
        let at = with s4.fetch(ar);
        while at.isDone() == false {
            s1.print("<cyan>.</>");
            s1.sleep(120ms);
        }
        s1.println("");
        const au = at.wait() catch av;
        if av != nil {
            &self::t(av);
        }
        const aw = s6.parse(au) catch ax;
        if ax != nil {
            &self::t("Failed to parse metadata JSON: $f{ax}");
        }
        &q =: au;
        &s =: aw.tag_name;
        return au;
    }

    func v() {
        const ay = "https://github.com/$f{&o}/releases/download/$f{&s}/project.xpack.sha256";
        let az = with s4.fetch(ay);
        while az.isDone() == false {
            s1.sleep(40ms);
        }
        const ba = az.wait() catch bb;
        if bb == nil && ba != "" {
            let bc = ba.trim();
            if bc.contains(" ") {
                let bd = bc.split(" ");
                bc =: bd.get(0).trim();
            }
            if bc.len() >= 64 {
                &r =: bc.slice(0, 64);
                return&r;
            }
        }
        if&q != "" {
            const be = s6.parse(&q) catch nil;
            if be != nil && be.body != nil {
                let bf = be.body;
                if bf.contains("sha256") || bf.contains("SHA256") {
                    let bg = bf.split("\n");
                    for bh in bg {
                        let bi = bh.trim();
                        if bi.toLower().contains("sha256") && bi.contains(":") {
                            let bj = bi.split(":");
                            if bj.len() >= 2 {
                                let bk = bj.get(1).trim();
                                if bk.len() >= 64 {
                                    &r =: bk.slice(0, 64);
                                    return&r;
                                }
                            }
                        }
                    }
                }
            }
        }
        return "";
    }

    func w(bl, bm) {
        if !s5.exists(bl) {
            return false;
        }
        const bn = s7.fileSha256(bl) catch bo;
        if bo != nil || bn == "" {
            s1.println("<red>[SECURITY:ERROR]</> Failed to compute SHA-256 for '$f{bl}'");
            return false;
        }
        if bm != "" {
            const bp = s7.verify(bn, bm);
            if !bp {
                s1.println("<red>[INTEGRITY:ERROR]</> Checksum mismatch for template bundle!");
                s1.println("  Expected : <yellow>$f{bm}</>");
                s1.println("  Received : <red>$f{bn}</>");
                s5.remove(bl);
                return false;
            }
            s1.println("<green>[VERIFIED]</> Checksum verified successfully (SHA-256: <bold>$f{bn.slice(0, 16)}...</>)");
        } else {
            s1.println("<cyan>[INTEGRITY]</> Template bundle SHA-256: <bold>$f{bn}</>");
        };
        const bq = "$f{bl}.sha256";
        s5.write(bq, bn);
        return true;
    }

    func x() {
        if s5.exists("out/project.xpack") {
            s1.println("<green>[LOCAL]</> Using local template bundle <bold>out/project.xpack</>");
            return "out/project.xpack";
        }
        &p =: "$f{s3.homeDir()}/.xfpm/cache";
        s5.ensureDir(&p);
        &self::u();
        if !&s {
            s1.fatal("Failed to resolve latest template version from GitHub");
        }
        &self::v();
        const br = "$f{&p}/project-$f{&s}.xpack";
        const bs = "$f{br}.sha256";
        if s5.exists(br) {
            let bt = &r;
            if bt == "" && s5.exists(bs) {
                bt =: s5.read(bs).trim();
            }
            if bt != "" {
                const bu = s7.verifyFile(br, bt);
                if bu {
                    s1.println("<green>[CACHE]</> Using verified cached template bundle <bold>$f{&s}</>");
                    return br;
                }
                s1.println("<yellow>[WARN]</> Cached template bundle failed integrity verification. Purging corrupt cache...");
                s5.remove(br);
                if s5.exists(bs) {
                    s5.remove(bs);
                }
            } else {
                s1.println("<green>[CACHE]</> Using cached template bundle <bold>$f{&s}</>");
                return br;
            }
        }
        const bv = "https://github.com/$f{&o}/releases/download/$f{&s}/project.xpack";
        s1.print("<blue>[DOWNLOADING]</> Fetching template bundle <bold>$f{&s}</>...");
        let bw = with s4.fetch(bv);
        while bw.isDone() == false {
            s1.print("<cyan>.</>");
            s1.sleep(120ms);
        }
        s1.println("");
        const bx = bw.wait() catch bz;
        if bz != nil {
            &self::t("Failed to download project bundle: $f{bz}");
        }
        s5.write(br, bx);
        const ca = &self::w(br, &r);
        if !ca && &r != "" {
            s1.fatal("Aborting initialization: Downloaded template bundle is corrupted or compromised.");
        }
        s1.println("<green>[SAVED]</> Template bundle cached at '<bold>$f{br}</>'");
        return br;
    }
}

const z = "2.1.9";
const aa = s3.os() == "windows";
const ab = s3.os() == "linux";
const ac = s3.os() == "macos";
const ad = s3.os() == "posix";

func ae() {
    if s5.exists("out/project.xpack") {
        s1.println("<green>[LOCAL]</> Using local template bundle <bold>out/project.xpack</>");
        return "out/project.xpack";
    }
    let cb = @y();
    return cb.x();
}

func af(cc) {
    const cd = cc.targetDir;
    const ce = cc.projectName;
    const cf = cc.projectMode;
    const cg = cc.shouldInstall;
    const ch = cc.projectDb;
    const ci = s8.Join(cd, "main.xru");
    if !s5.exists(ci) {
        s1.fatal("Critical error: main.xru was not found in destination directory after unpack!");
    }
    const cj = s8.Join(cd, "xfpm.resolve.lock");
    if s5.exists(cj) {
        s5.remove(cj);
    }
    const ck = s8.Join(cd, "fileonix.config.json");
    if s5.exists(ck) {
        file ck, (cl, cm) -> {
            if cm != nil {
                return;
            }
            cl.setJson("watch", [cd]);
        }
    }
    let cn = "xru run \"$f{ci}\" --name=\"$f{ce}\" --mode=\"$f{cf}\" --port=$f{j} --version=\"$f{b}\" --description=\"$f{c}\" --author=\"$f{d}\" --server_timeout=$f{k} --database=\"$f{ch}\"";
    if f == false {
        cn =: cn + " --no-xems";
    }
    if g == false {
        cn =: cn + " --no-cdn";
    }
    if h == true {
        cn =: cn + " --plugin";
    }
    if cg == true {
        cn =: cn + " --install";
    } else {
        cn =: cn + " --no-install";
    };
    s1.println("\n<cyan><bold>◆ [3/4]</> Configuring project & running parallel orchestrations...");
    const co = with s9.exec(cn, cd);
    const cp = with s4.isPortBusy(j);
    let cq = 0;
    const cr = if k > 0 -> k else 120000;
    while !co.isDone() {
        s1.sleep(500ms);
        cq =: cq + 500;
        if cq >= cr {
            s1.println("\n<red>[TIMEOUT]</> Template orchestration exceeded timeout limit ($f{cr}ms).");
            co.cancel();
            break
        }
    }
    co.wait() catch cs;
    if cs != nil {
        s1.fatal("Template orchestration failed: $f{cs}");
    }
    s1.println("  <green>✔</> Environment & presets configured.");
    const ct = s8.Join(cd, ".git");
    if !s5.exists(ct) {
        const cu = s8.Join(cd, ".gitignore");
        file cu, (cv, cw) -> {
            if cw != nil {
                return;
            }
            cv.append("\n# Environment variables & secrets\n.env\n.env.*\n.env.local\n.env.remote\n.storage.xems\n");
        }
        const cx = "master";
        const cy = if d != "" -> "by $f{d}" else ".";
        cout s9::@map{dir : cd, out, err} as c {
            ::exec("git init");
            ::exec("git add .");
            ::exec("git reset HEAD .env");
            ::exec("git commit -m \"Initial commit from xfpm init $f{cy}\"");
            ::exec("git branch -M $f{cx}");
        }
        if c.ok {
            s1.println("  <green>✔</> Git repository initialized.");
        }
    }
    s1.println("\n<cyan><bold>◆ [4/4]</> Validating network environment...");
    const cz = cp.wait() catch or false;
    if cz {
        s1.println("  <yellow>▲ [WARN]</> Port <bold>$f{j}</> is currently in use on localhost.");
        s1.println("  <yellow>▲ [WARN]</> You may want to configure a different port before launching.");
    } else {
        s1.println("  <green>✔</> Port <bold>$f{j}</> is free and available.");
    }
}

s3.require(">= 2.1.9", @map {
    onMismatch: "auto-update", mode: "log"
}
);
let ag = a;
let ah = e;
let ai = m;
let aj = i;
if !s3.hasArg() {
    s1.println("<cyan>╭─────────────────────────────────────────────────────────────╮</>");
    s1.println("<cyan>│</>  <bold>🚀  XyPriss Project Initializer (Interactive)</>              <cyan>│</>");
    s1.println("<cyan>╰─────────────────────────────────────────────────────────────╯</>");
    s1.println("");
    s1::in {
        const da = ::input("<cyan>?</> <bold>Project name or directory:</> (my-xypriss-app) ", "my-xypriss-app");
        ag =: da;
        const db = ::select("<cyan>?</> <bold>Select architecture preset:</>", ["default (Enterprise multi-server: Auth, API, CDN, XEMS)", "minimal (Lightweight single-server)"]);
        if db.startsWith("minimal") {
            ah =: "minimal";
        } else {
            ah =: "default";
        };
        const dc = ::select("<cyan>?</> <bold>Select database / ORM provider:</>", ["none (No database - default)", "prisma (Prisma ORM with PostgreSQL)", "drizzle (Drizzle ORM with PostgreSQL)"]);
        if dc.startsWith("prisma") {
            ai =: "prisma";
        } elif dc.startsWith("drizzle") {
            ai =: "drizzle";
        } else {
            ai =: "none";
        };
        const dd = ::confirm("<cyan>?</> <bold>Install dependencies immediately with xfpm?</>", true);
        aj =: dd;
    }
    s1.println("");
}
const ak = if ag.startsWith("/") -> ag else s8.Join(s3.cwd(), ag);
let al = false;
trap s2::@map{interrupt, terminate} as s {
    if !al {
        s1.println("\n<red>[CRITICAL:ABORT]</> Process interrupted by <bold>$f{s}</>. Cleaning up...");
        if s5.exists(ak) {
            s5.remove(ak);
            s1.println("<yellow>[CLEANUP]</> Removed incomplete directory '<bold>$f{ak}</>'");
        }
    }
}
if s5.exists(ak) {
    if l == false {
        s1.fatal("Destination directory '$f{ak}' already exists. Use --force to overwrite.");
    }
    s1.println("<yellow>[CLEANUP]</> Overwriting existing directory '<bold>$f{ak}</>'...");
    s5.remove(ak);
}
const am = if aj -> "<green>enabled</>" else "<yellow>disabled</>";
s1.println("<cyan>╭─────────────────────────────────────────────────────────────╮</>");
s1.println("<cyan>│</>  <bold>🚀  XyPriss Project Initializer</>                               <cyan>│</>");
s1.println("<cyan>├─────────────────────────────────────────────────────────────┤</>");
s1.println("<cyan>│</>  Target   : <bold>$f{ag}</>");
s1.println("<cyan>│</>  Preset   : <cyan><bold>$f{ah}</></>");
s1.println("<cyan>│</>  Database : <yellow><bold>$f{ai}</></>");
s1.println("<cyan>│</>  Port     : <bold>$f{j}</>");
s1.println("<cyan>│</>  Install  : $f{am}");
s1.println("<cyan>╰─────────────────────────────────────────────────────────────╯</>");
s1.println("");
s1.println("<cyan><bold>◆ [1/4]</> Resolving template bundle...");
const an = ae();
s1.println("\n<cyan><bold>◆ [2/4]</> Extracting project template into '<bold>$f{ak}</>'...");
s9.exec("xru unpack \"$f{an}\" \"$f{ak}\"");
s1.println("  <green>✔</> Template unpacked successfully.");
const ao = @map {
    targetDir: ak, projectMode: ah, projectName: ag, shouldInstall: aj, projectDb: ai
};
af(ao);
al =: true;
s1.println("");
s1.println("<green>╭─────────────────────────────────────────────────────────────╮</>");
s1.println("<green>│</>  <bold>✨  Project initialized successfully!</>                       <green>│</>");
s1.println("<green>╰─────────────────────────────────────────────────────────────╯</>");
s1.println("");
if !n {
    s1.println("  <bold>Next steps:</>");
    if ag != "." && ag != "./" {
        s1.println("    <cyan>→</> cd <bold>$f{ag}</>");
    }
    if !aj {
        s1.println("    <cyan>→</> 'xfpm install'</>");
    }
    if ai == "prisma" {
        s1.println("    <cyan>→</> 'xfpmx prisma db push' <bold>(sync schema to database)</>");
    } elif ai == "drizzle" {
        s1.println("    <cyan>→</> 'xfpmx drizzle-kit push' <bold>(sync schema to database)</>");
    };
    s1.println("    <cyan>→</> 'xfpm run dev' <bold>or</> <cyan>'dev'</>");
} else {
    const de = s8.join(ak);
    if !aj {
        s1.println("  <yellow>[WARNING]</> Dependencies are not installed. Run <cyan>'xfpm install'</> before starting the dev server.");
        return;
    }
    s1.println("  <bold>Starting dev server...</>");
    s9.exec(if aa -> "xfpm run dev" else "dev", de)
};
s1.println("");
