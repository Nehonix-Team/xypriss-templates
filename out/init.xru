use std as s1;
use sig as s2;
use sys as s3;
use net as s4;
use fs as s5;
use json as s6;
use path as s7;
use cmd as s8;
global arg name, n as a: string = "my-xypriss-app";
global arg version, v as b: string = "1.0.0";
global arg description, d as c: string = "Enterprise-grade XyPriss backend service";
global arg author, a as d: string = "";
global arg mode, m as e: string = "default";
global arg xems, x as f: bool = true;
global arg cdn, c as g: bool = true;
global arg plugin as h: bool = false;
global arg install, i as i: bool = true;
global arg port, p as j: number = 7182;
global arg server_timeout, t as k: number = 30000;
global arg force, f as l: bool = false;
arg start_server, st as m: bool = false;

interface orchestrator__IExecProps @map {
    targetDir string;
    projectName string;
    projectMode string;
    shouldInstall bool;
}

unit t {
    declare private n: string = "Nehonix-Team/xypriss-templates";
    declare private o: string = "";
    declare p: string = "";

    func q(ai) {
        const aj = "Downloading error: $f{ai}";
        s1.fatal(aj);
    }

    func r() {
        const ak = "https://api.github.com/repos/$f{&n}/releases/latest";
        s1.print("<yellow>[FETCHING]</> Querying latest template release...");
        let al = with s4.fetch(ak);
        while al.isDone() == false {
            s1.print("<cyan>.</>");
            s1.sleep(120ms);
        }
        s1.println("");
        const am = al.wait() catch an;
        if an != nil {
            &self::q(an);
        }
        const ao = s6.parse(am) catch ap;
        if ap != nil {
            &self::q("Failed to parse metadata JSON: $f{ap}");
        }
        &p =: ao.tag_name;
        return am;
    }

    func s() {
        &o =: "$f{s3.homeDir()}/.xfpm/cache";
        s5.ensureDir(&o);
        &self::r();
        if !&p {
            s1.fatal("Failed to resolve latest template version from GitHub");
        }
        const aq = "$f{&o}/project-$f{&p}.xpack";
        if s5.exists(aq) {
            s1.println("<green>[CACHE]</> Using cached template bundle <bold>$f{&p}</>");
            return aq;
        }
        const ar = "https://github.com/$f{&n}/releases/download/$f{&p}/project.xpack";
        s1.print("<blue>[DOWNLOADING]</> Fetching template bundle <bold>$f{&p}</>...");
        let at = with s4.fetch(ar);
        while at.isDone() == false {
            s1.print("<cyan>.</>");
            s1.sleep(120ms);
        }
        s1.println("");
        const au = at.wait() catch av;
        if av != nil {
            &self::q("Failed to download project bundle: $f{av}");
        }
        s5.write(aq, au);
        s1.println("<green>[SAVED]</> Template bundle cached at '<bold>$f{aq}</>'");
        return aq;
    }
}

const u = "2.1.8";
const v = s3.os() == "windows";
const w = s3.os() == "linux";
const x = s3.os() == "macos";
const y = s3.os() == "posix";

func z() {
    let aw = @t();
    return aw.s();
}

func aa(ax) {
    const ay = ax.targetDir;
    const az = ax.projectName;
    const ba = ax.projectMode;
    const bb = ax.shouldInstall;
    const bc = s7.Join(ay, "main.xru");
    if !s5.exists(bc) {
        s1.fatal("Critical error: main.xru was not found in destination directory after unpack!");
    }
    const bd = s7.Join(ay, "fileonix.config.json");
    if s5.exists(bd) {
        file bd, (be, bf) -> {
            if bf != nil {
                return;
            }
            be.setJson("watch", [ay]);
        }
    }
    let bg = "xru run \"$f{bc}\" --name=\"$f{az}\" --mode=\"$f{ba}\" --port=$f{j} --version=\"$f{b}\" --description=\"$f{c}\" --author=\"$f{d}\" --server_timeout=$f{k}";
    if f == false {
        bg =: bg + " --no-xems";
    }
    if g == false {
        bg =: bg + " --no-cdn";
    }
    if h == true {
        bg =: bg + " --plugin";
    }
    if bb == false {
        bg =: bg + " --no-install";
    }
    s1.println("\n<cyan><bold>◆ [3/4]</> Configuring project & running parallel orchestrations...");
    const bh = with s8.exec(bg, ay);
    const bi = with s4.isPortBusy(j);
    let bj = 0;
    const bk = if k > 0 -> k else 120000;
    while !bh.isDone() {
        s1.sleep(500ms);
        bj =: bj + 500;
        if bj >= bk {
            s1.println("\n<red>[TIMEOUT]</> Template orchestration exceeded timeout limit ($f{bk}ms).");
            bh.cancel();
            break
        }
    }
    bh.wait() catch bl;
    if bl != nil {
        s1.fatal("Template orchestration failed: $f{bl}");
    }
    s1.println("  <green>✔</> Environment & presets configured.");
    const bm = s7.Join(ay, ".git");
    if !s5.exists(bm) {
        const bn = "master";
        const bo = if d != "" -> "by $f{d}" else ".";
        const bp = s8.exec("git init", ay) catch nil;
        if bp != nil {
            s8.exec("git add .", ay) catch nil;
            s8.exec("git commit -m \"Initial commit from xfpm init $f{bo}\"", ay) catch nil;
            s8.exec("git branch -M $f{bn}", ay) catch nil;
            s1.println("  <green>✔</> Git repository initialized.");
        }
    }
    s1.println("\n<cyan><bold>◆ [4/4]</> Validating network environment...");
    const bq = bi.wait() catch or false;
    if bq {
        s1.println("  <yellow>▲ [WARN]</> Port <bold>$f{j}</> is currently in use on localhost.");
        s1.println("  <yellow>▲ [WARN]</> You may want to configure a different port before launching.");
    } else {
        s1.println("  <green>✔</> Port <bold>$f{j}</> is free and available.");
    }
}

s3.require(">= 2.1.8", @map {
    onMismatch: "auto-update", mode: "log"
}
);
let ab = a;
let ac = e;
let ad = i;
if !s3.hasArg() {
    s1.println("<cyan>╭─────────────────────────────────────────────────────────────╮</>");
    s1.println("<cyan>│</>  <bold>🚀  XyPriss Project Initializer (Interactive)</>              <cyan>│</>");
    s1.println("<cyan>╰─────────────────────────────────────────────────────────────╯</>");
    s1.println("");
    s1::in {
        const br = ::input("<cyan>?</> <bold>Project name or directory:</> (my-xypriss-app) ", "my-xypriss-app");
        ab =: br;
        const bs = ::select("<cyan>?</> <bold>Select architecture preset:</>", ["default (Enterprise multi-server: Auth, API, CDN, XEMS)", "minimal (Lightweight single-server)"]);
        if bs.startsWith("minimal") {
            ac =: "minimal";
        } else {
            ac =: "default";
        };
        const bt = ::confirm("<cyan>?</> <bold>Install dependencies immediately with xfpm?</>", true);
        ad =: bt;
    }
    s1.println("");
}
const ae = if ab.startsWith("/") -> ab else s7.Join(s3.cwd(), ab);
trap s2::@map{interrupt, terminate} as s {
    s1.println("\n<red>[CRITICAL:ABORT]</> Process interrupted by <bold>$f{s}</>. Cleaning up...");
    if s5.exists(ae) {
        s5.remove(ae);
        s1.println("<yellow>[CLEANUP]</> Removed incomplete directory '<bold>$f{ae}</>'");
    }
}
if s5.exists(ae) {
    if l == false {
        s1.fatal("Destination directory '$f{ae}' already exists. Use --force to overwrite.");
    }
    s1.println("<yellow>[CLEANUP]</> Overwriting existing directory '<bold>$f{ae}</>'...");
    s5.remove(ae);
}
const af = if ad -> "<green>enabled</>" else "<yellow>disabled</>";
s1.println("<cyan>╭─────────────────────────────────────────────────────────────╮</>");
s1.println("<cyan>│</>  <bold>🚀  XyPriss Project Initializer</>                               <cyan>│</>");
s1.println("<cyan>├─────────────────────────────────────────────────────────────┤</>");
s1.println("<cyan>│</>  Target   : <bold>$f{ab}</>");
s1.println("<cyan>│</>  Preset   : <cyan><bold>$f{ac}</></>");
s1.println("<cyan>│</>  Port     : <bold>$f{j}</>");
s1.println("<cyan>│</>  Install  : $f{af}");
s1.println("<cyan>╰─────────────────────────────────────────────────────────────╯</>");
s1.println("");
s1.println("<cyan><bold>◆ [1/4]</> Resolving template bundle...");
const ag = z();
s1.println("\n<cyan><bold>◆ [2/4]</> Extracting project template into '<bold>$f{ae}</>'...");
s8.exec("xru unpack \"$f{ag}\" \"$f{ae}\"");
s1.println("  <green>✔</> Template unpacked successfully.");
const ah = @map {
    targetDir: ae, projectMode: ac, projectName: ab, shouldInstall: ad
};
aa(ah);
s1.println("");
s1.println("<green>╭─────────────────────────────────────────────────────────────╮</>");
s1.println("<green>│</>  <bold>✨  Project initialized successfully!</>                       <green>│</>");
s1.println("<green>╰─────────────────────────────────────────────────────────────╯</>");
s1.println("");
if !m {
    s1.println("  <bold>Next steps:</>");
    if ab != "." && ab != "./" {
        s1.println("    <cyan>→</> cd <bold>$f{ab}</>");
    }
    s1.println("    <cyan>→</> 'xfpm run dev' <bold>or</> <cyan>'dev'</>");
} else {
    const bu = s7.join(ae);
    s1.println("  <bold>Starting dev server...</>");
    s8.exec(if v -> "xfpm run dev" else "dev", bu)
};
s1.println("");
