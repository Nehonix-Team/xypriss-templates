for dw in s5.args(){const dx = dw.trim();if dx!="-f"&&dx!="--force"&&!dx.startsWith("-f=")&&!dx.startsWith("--force=")&&dx!="-y"&&dx!="--yes"&&!dx.startsWith("-y=")&&!dx.startsWith("--yes="){ao=:true;break}};
if an{am=:true};
if !ao&&!an{s3.println("<cyan>╭─────────────────────────────────────────────────────────────╮</>");s3.println("<cyan>│</>  <bold>🚀  XyPriss Project Initializer (Interactive)</>              <cyan>│</>");s3.println("<cyan>╰─────────────────────────────────────────────────────────────╯</>");s3.println("");s3::in{const dy = ::input("<cyan>?</> <bold>Project name or directory:</> (my-xypriss-app) ","my-xypriss-app");ai=:dy;const dz = if dy.startsWith("/") -> dy else s6.Join(s5.cwd(),dy);if s1.exists(dz)&&!am{const ea = ::confirm("<yellow>?</> <bold>Target directory '$f{dy}' already exists. Overwrite?</>",false);if !ea{s3.println("<red>[ABORT]</> Destination directory already exists. Setup aborted.");s5.exit(1)};am=:true};const eb = ::select("<cyan>?</> <bold>Select architecture preset:</>",["default (Enterprise multi-server: Auth, API, CDN, XEMS)","minimal (Lightweight single-server)"]);if eb.startsWith("minimal"){aj=:"minimal"} else{aj=:"default"};const ec = ::select("<cyan>?</> <bold>Select database / ORM provider:</>",["none (No database - default)","drizzle (Drizzle ORM with PostgreSQL - Recommended)","prisma (Prisma ORM v7 with PostgreSQL)"]);if ec.startsWith("drizzle"){ak=:"drizzle"} elif ec.startsWith("prisma"){ak=:"prisma"} else{ak=:"none"};const ed = ::confirm("<cyan>?</> <bold>Install dependencies immediately with xfpm?</>",true);al=:ed};s3.println("")};
