if s1.exists(ap){if am==false{s3.fatal("Destination directory '$f{ap}' already exists. Use --force to overwrite.")};s3.println("<yellow>[CLEANUP]</> Overwriting existing directory '<bold>$f{ap}</>'...");s1.remove(ap)};
