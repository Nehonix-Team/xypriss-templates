use std as s1;
use sig as s2;
use sys as s3;
use net as s4;
use fs as s5;
use json as s6;
use crypto as s7;
use path as s8;
use cmd as s9;
global arg name, n as a: string = "my-xypriss-app";
global arg version, v as b: string = "1.0.0";
global arg description, d as c: string = "Enterprise-grade XyPriss backend service";
global arg author, a as d: string = "";
global arg mode, m as e: "default" or "minimal" = "default";
global arg xems, x as f: bool = true;
global arg cdn, c as g: bool = true;
global arg plugin as h: bool = false;
global arg install, i as i: bool = false;
global arg port, p as j: number = 7182;
global arg server_timeout, t as k: number = 30000;
global arg force, f as l: bool = false;
global arg database, db as m: "none" or "drizzle" or "prisma" or "postgresql" = "none";
arg start_server, st as n: bool = false;

interface orchestrator__IExecProps @map {
    targetDir string;
    projectName string;
    projectMode string;
    shouldInstall bool;
    projectDb string;
}

unit y {
    declare private o: string = "Nehonix-Team/xypriss-templates";
    declare private p: string = "";
    declare private q: string = "";
    declare private r: string = "";
    declare s: string = "";

    func t(ar) {
        const at = "Downloading error: $f{ar}";
        s1.fatal(at);
    }

    func u() {
        const au = "https://api.github.com/repos/$f{&o}/releases/latest";
        s1.print("<yellow>[FETCHING]</> Querying latest template release...");
        let av = with s4.fetch(au);
        while av.isDone() == false {
            s1.print("<cyan>.</>");
            s1.sleep(120ms);
        }
        s1.println("");
        const aw = av.wait() catch ax;
        if ax != nil {
            &self::t(ax);
        }
        const ay = s6.parse(aw) catch az;
        if az != nil {
            &self::t("Failed to parse metadata JSON: $f{az}");
        }
        &q =: aw;
        &s =: ay.tag_name;
        return aw;
    }

    func v() {
        const ba = "https://github.com/$f{&o}/releases/download/$f{&s}/project.xpack.sha256";
        let bb = with s4.fetch(ba);
        while bb.isDone() == false {
            s1.sleep(40ms);
        }
        const bc = bb.wait() catch bd;
        if bd == nil && bc != "" {
            let be = bc.trim();
            if be.contains(" ") {
                let bf = be.split(" ");
                be =: bf.get(0).trim();
            }
            if be.len() >= 64 {
                &r =: be.slice(0, 64);
                return&r;
            }
        }
        if&q != "" {
            const bg = s6.parse(&q) catch nil;
            if bg != nil && bg.body != nil {
                let bh = bg.body;
                if bh.contains("sha256") || bh.contains("SHA256") {
                    let bi = bh.split("\n");
                    for bj in bi {
                        let bk = bj.trim();
                        if bk.toLower().contains("sha256") && bk.contains(":") {
                            let bl = bk.split(":");
                            if bl.len() >= 2 {
                                let bm = bl.get(1).trim();
                                if bm.len() >= 64 {
                                    &r =: bm.slice(0, 64);
                                    return&r;
                                }
                            }
                        }
                    }
                }
            }
        }
        return "";
    }

    func w(bn, bo) {
        if !s5.exists(bn) {
            return false;
        }
        const bp = s7.fileSha256(bn) catch bq;
        if bq != nil || bp == "" {
            s1.println("<red>[SECURITY:ERROR]</> Failed to compute SHA-256 for '$f{bn}'");
            return false;
        }
        if bo != "" {
            const br = s7.verify(bp, bo);
            if !br {
                s1.println("<red>[INTEGRITY:ERROR]</> Checksum mismatch for template bundle!");
                s1.println("  Expected : <yellow>$f{bo}</>");
                s1.println("  Received : <red>$f{bp}</>");
                s5.remove(bn);
                return false;
            }
            s1.println("<green>[VERIFIED]</> Checksum verified successfully (SHA-256: <bold>$f{bp.slice(0, 16)}...</>)");
        } else {
            s1.println("<cyan>[INTEGRITY]</> Template bundle SHA-256: <bold>$f{bp}</>");
        };
        const bs = "$f{bn}.sha256";
        s5.write(bs, bp);
        return true;
    }

    func x() {
        if s5.exists("out/project.xpack") {
            s1.println("<green>[LOCAL]</> Using local template bundle <bold>out/project.xpack</>");
            return "out/project.xpack";
        }
        &p =: "$f{s3.homeDir()}/.xfpm/cache";
        s5.ensureDir(&p);
        &self::u();
        if !&s {
            s1.fatal("Failed to resolve latest template version from GitHub");
        }
        &self::v();
        const bt = "$f{&p}/project-$f{&s}.xpack";
        const bu = "$f{bt}.sha256";
        if s5.exists(bt) {
            let bv = &r;
            if bv == "" && s5.exists(bu) {
                bv =: s5.read(bu).trim();
            }
            if bv != "" {
                const bw = s7.verifyFile(bt, bv);
                if bw {
                    s1.println("<green>[CACHE]</> Using verified cached template bundle <bold>$f{&s}</>");
                    return bt;
                }
                s1.println("<yellow>[WARN]</> Cached template bundle failed integrity verification. Purging corrupt cache...");
                s5.remove(bt);
                if s5.exists(bu) {
                    s5.remove(bu);
                }
            } else {
                s1.println("<green>[CACHE]</> Using cached template bundle <bold>$f{&s}</>");
                return bt;
            }
        }
        const bx = "https://github.com/$f{&o}/releases/download/$f{&s}/project.xpack";
        s1.print("<blue>[DOWNLOADING]</> Fetching template bundle <bold>$f{&s}</>...");
        let bz = with s4.fetch(bx);
        while bz.isDone() == false {
            s1.print("<cyan>.</>");
            s1.sleep(120ms);
        }
        s1.println("");
        const ca = bz.wait() catch cb;
        if cb != nil {
            &self::t("Failed to download project bundle: $f{cb}");
        }
        s5.write(bt, ca);
        const cc = &self::w(bt, &r);
        if !cc && &r != "" {
            s1.fatal("Aborting initialization: Downloaded template bundle is corrupted or compromised.");
        }
        s1.println("<green>[SAVED]</> Template bundle cached at '<bold>$f{bt}</>'");
        return bt;
    }
}

const z = "2.1.10";
const aa = s3.os() == "windows";
const ab = s3.os() == "linux";
const ac = s3.os() == "macos";
const ad = s3.os() == "posix";

func ae() {
    if s5.exists("out/project.xpack") {
        s1.println("<green>[LOCAL]</> Using local template bundle <bold>out/project.xpack</>");
        return "out/project.xpack";
    }
    let cd = @y();
    return cd.x();
}

func af(ce) {
    const cf = ce.targetDir;
    const cg = ce.projectName;
    const ch = ce.projectMode;
    const ci = ce.shouldInstall;
    const cj = ce.projectDb;
    const ck = s8.Join(cf, "main.xru");
    if !s5.exists(ck) {
        s1.fatal("Critical error: main.xru was not found in destination directory after unpack!");
    }
    const cl = s8.Join(cf, "xfpm.resolve.lock");
    if s5.exists(cl) {
        s5.remove(cl);
    }
    const cm = s8.Join(cf, "fileonix.config.json");
    if s5.exists(cm) {
        file cm, (cn, co) -> {
            if co != nil {
                return;
            }
            cn.setJson("watch", [cf]);
        }
    }
    let cp = "xru run \"$f{ck}\" --name=\"$f{cg}\" --mode=\"$f{ch}\" --port=$f{j} --version=\"$f{b}\" --description=\"$f{c}\" --author=\"$f{d}\" --server_timeout=$f{k} --database=\"$f{cj}\"";
    if f == false {
        cp =: cp + " --no-xems";
    }
    if g == false {
        cp =: cp + " --no-cdn";
    }
    if h == true {
        cp =: cp + " --plugin";
    }
    if ci == true {
        cp =: cp + " --install";
    } else {
        cp =: cp + " --no-install";
    };
    s1.println("\n<cyan><bold>◆ [3/4]</> Configuring project & running parallel orchestrations...");
    const cq = with s9.exec(cp, cf);
    const cr = with s4.isPortBusy(j);
    let cs = 0;
    const ct = if k > 0 -> k else 120000;
    while !cq.isDone() {
        s1.sleep(500ms);
        cs =: cs + 500;
        if cs >= ct {
            s1.println("\n<red>[TIMEOUT]</> Template orchestration exceeded timeout limit ($f{ct}ms).");
            cq.cancel();
            break
        }
    }
    cq.wait() catch cu;
    if cu != nil {
        s1.fatal("Template orchestration failed: $f{cu}");
    }
    s1.println("  <green>✔</> Environment & presets configured.");
    const cv = s8.Join(cf, ".git");
    if !s5.exists(cv) {
        const cw = s8.Join(cf, ".gitignore");
        file cw, (cx, cy) -> {
            if cy != nil {
                return;
            }
            cx.append("\n# Environment variables & secrets\n.env\n.env.*\n.env.local\n.env.remote\n.storage.xems\n");
        }
        const cz = "master";
        const da = if d != "" -> "by $f{d}" else ".";
        cout s9::@map{dir : cf, out, err} as c {
            ::exec("git init");
            ::exec("git add .");
            ::exec("git reset HEAD .env");
            ::exec("git commit -m \"Initial commit from xfpm init $f{da}\"");
            ::exec("git branch -M $f{cz}");
        }
        if c.ok {
            s1.println("  <green>✔</> Git repository initialized.");
        }
    }
    s1.println("\n<cyan><bold>◆ [4/4]</> Validating network environment...");
    const db = cr.wait() catch or false;
    if db {
        s1.println("  <yellow>▲ [WARN]</> Port <bold>$f{j}</> is currently in use on localhost.");
        s1.println("  <yellow>▲ [WARN]</> You may want to configure a different port before launching.");
    } else {
        s1.println("  <green>✔</> Port <bold>$f{j}</> is free and available.");
    }
}

s3.require(">= 2.1.10", @map {
    onMismatch: "auto-update", mode: "log"
}
);
let ag = a;
let ah = e;
let ai = m;
let aj = i;
let ak = l;
let al = false;
for dc in s3.args() {
    const dd = dc.trim();
    if dd != "-f" && dd != "--force" && !dd.startsWith("-f=") && !dd.startsWith("--force=") {
        al =: true;
        break
    }
}
if !al {
    s1.println("<cyan>╭─────────────────────────────────────────────────────────────╮</>");
    s1.println("<cyan>│</>  <bold>🚀  XyPriss Project Initializer (Interactive)</>              <cyan>│</>");
    s1.println("<cyan>╰─────────────────────────────────────────────────────────────╯</>");
    s1.println("");
    s1::in {
        const de = ::input("<cyan>?</> <bold>Project name or directory:</> (my-xypriss-app) ", "my-xypriss-app");
        ag =: de;
        const df = if de.startsWith("/") -> de else s8.Join(s3.cwd(), de);
        if s5.exists(df) && !ak {
            const dg = ::confirm("<yellow>?</> <bold>Target directory '$f{de}' already exists. Overwrite?</>", false);
            if !dg {
                s1.println("<red>[ABORT]</> Destination directory already exists. Setup aborted.");
                s3.exit(1);
            }
            ak =: true;
        }
        const dh = ::select("<cyan>?</> <bold>Select architecture preset:</>", ["default (Enterprise multi-server: Auth, API, CDN, XEMS)", "minimal (Lightweight single-server)"]);
        if dh.startsWith("minimal") {
            ah =: "minimal";
        } else {
            ah =: "default";
        };
        const di = ::select("<cyan>?</> <bold>Select database / ORM provider:</>", ["none (No database - default)", "drizzle (Drizzle ORM with PostgreSQL - Recommended)", "prisma (Prisma ORM v7 with PostgreSQL)"]);
        if di.startsWith("drizzle") {
            ai =: "drizzle";
        } elif di.startsWith("prisma") {
            ai =: "prisma";
        } else {
            ai =: "none";
        };
        const dj = ::confirm("<cyan>?</> <bold>Install dependencies immediately with xfpm?</>", true);
        aj =: dj;
    }
    s1.println("");
}
const am = if ag.startsWith("/") -> ag else s8.Join(s3.cwd(), ag);
let an = false;
trap s2::@map{interrupt, terminate} as s {
    if !an {
        s1.println("\n<red>[CRITICAL:ABORT]</> Process interrupted by <bold>$f{s}</>. Cleaning up...");
        if s5.exists(am) {
            s5.remove(am);
            s1.println("<yellow>[CLEANUP]</> Removed incomplete directory '<bold>$f{am}</>'");
        }
    }
}
if s5.exists(am) {
    if ak == false {
        s1.fatal("Destination directory '$f{am}' already exists. Use --force to overwrite.");
    }
    s1.println("<yellow>[CLEANUP]</> Overwriting existing directory '<bold>$f{am}</>'...");
    s5.remove(am);
}
const ao = if aj -> "<green>enabled</>" else "<yellow>disabled</>";
s1.println("<cyan>╭─────────────────────────────────────────────────────────────╮</>");
s1.println("<cyan>│</>  <bold>🚀  XyPriss Project Initializer</>                               <cyan>│</>");
s1.println("<cyan>├─────────────────────────────────────────────────────────────┤</>");
s1.println("<cyan>│</>  Target   : <bold>$f{ag}</>");
s1.println("<cyan>│</>  Preset   : <cyan><bold>$f{ah}</></>");
s1.println("<cyan>│</>  Database : <yellow><bold>$f{ai}</></>");
s1.println("<cyan>│</>  Port     : <bold>$f{j}</>");
s1.println("<cyan>│</>  Install  : $f{ao}");
s1.println("<cyan>╰─────────────────────────────────────────────────────────────╯</>");
s1.println("");
s1.println("<cyan><bold>◆ [1/4]</> Resolving template bundle...");
const ap = ae();
s1.println("\n<cyan><bold>◆ [2/4]</> Extracting project template into '<bold>$f{am}</>'...");
s9.exec("xru unpack \"$f{ap}\" \"$f{am}\"");
s1.println("  <green>✔</> Template unpacked successfully.");
const aq = @map {
    targetDir: am, projectMode: ah, projectName: ag, shouldInstall: aj, projectDb: ai
};
af(aq);
an =: true;
s1.println("");
s1.println("<green>╭─────────────────────────────────────────────────────────────╮</>");
s1.println("<green>│</>  <bold>✨  Project initialized successfully!</>                       <green>│</>");
s1.println("<green>╰─────────────────────────────────────────────────────────────╯</>");
s1.println("");
if !n {
    s1.println("  <bold>Next steps:</>");
    if ag != "." && ag != "./" {
        s1.println("    <cyan>→</> cd <bold>$f{ag}</>");
    }
    if !aj {
        s1.println("    <cyan>→</> 'xfpm install'</>");
    }
    if ai == "prisma" {
        s1.println("    <cyan>→</> 'xfpmx prisma db push' <bold>(sync schema to database)</>");
    } elif ai == "drizzle" {
        s1.println("    <cyan>→</> 'xfpmx drizzle-kit push' <bold>(sync schema to database)</>");
    };
    s1.println("    <cyan>→</> 'xfpm run dev' <bold>or</> <cyan>'dev'</>");
} else {
    const dk = s8.join(am);
    if !aj {
        s1.println("  <yellow>[WARNING]</> Dependencies are not installed. Run <cyan>'xfpm install'</> before starting the dev server.");
        return;
    }
    s1.println("  <bold>Starting dev server...</>");
    s9.exec(if aa -> "xfpm run dev" else "dev", dk)
};
s1.println("");
