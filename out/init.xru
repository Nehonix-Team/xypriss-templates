}
const ab = if z -> "<green>enabled</>" else "<yellow>disabled</>";
s1.println("<cyan>╭─────────────────────────────────────────────────────────────╮</>");
s1.println("<cyan>│</>  <bold>🚀  XyPriss Project Initializer</>                               <cyan>│</>");
