#IF: {PLUGIN} != ""
    U.LOG: "<cyan>[INFO]</> Preparing plugin environment..."

    #CREATE: "xypriss.config.jsonc"
// This file is a configuration file for XyPriss Plugins.
// For more information, check the documentation at:
// https://xypriss.nehonix.com/docs/plugins

{
  "type": "plugin",
  "$vars": {
    "__name__": "&(pkg).name",
    "__description__": "&(pkg).description",
    "__version__": "&(pkg).version",
    "__author__": "&(pkg).author"
  }
}
    #END

    #CREATE: "README.md"
# {NAME}

Welcome to your new **XyPriss Plugin**. This project is configured for developing high-performance plugins for the XyPriss ecosystem.

## Overview

{DESCRIPTION}

## Development

1. **Install Dependencies**:
   ```bash
   xfpm install
   ```

2. **Inspect Permissions**:
   ```bash
   xfpm run inspect
   ```
   > **Note:** Do not forget to add the discovered permissions to your `package.json` under the `xfpm.permissions` key (e.g., `["XHS.HOOK.HTTP.REQUEST"]`). Full list: [Unified Hook Registry](https://xypriss.nehonix.com/docs/plugins/api-reference/hooks)

3. **Configure Files**:
   Ensure that the `files` array in your `package.json` contains the directories you want to publish (e.g., `"dist"`) and absolutely must include `"xypriss.plugin.xsig"`. (This template pre-configures it for you).

4. **Sign Plugin**:
   ```bash
   xfpm run sign
   ```

## Documentation

- [XyPriss Plugins Documentation](https://xypriss.nehonix.com/docs/plugins)
- [Authoring Plugins Guide](https://xypriss.nehonix.com/docs/plugins/tutorials/authoring)
- [API Reference](https://xypriss.nehonix.com/docs/plugins/api-reference/hooks)

---
*Plugin initialized by {AUTHOR} using XFPM*
    #END

    #CREATE: ".env"
XYPRISS_SHIELD="silent"
// # PLUGIN_SECRET="your-plugin-secret-here" // non necessaire
    #END

    FS.RM: "src"
    FS.MKDIR: "src"
    FS.MKDIR: "scripts"
    
    #CREATE: "src/index.ts"
import { Plugin } from "xypriss";
import type {
  PluginServer,
  Request,
  Response,
  NextFunction,
  XyPrissPlugin,
} from "xypriss";


export interface PluginOptions {
    // Define your plugin options here
}

export function {NAME}(options: PluginOptions = {}): XyPrissPlugin {
    const pkg = Plugin.manifest<{ name: string; version: string; description: string }>(__sys__);

    return Plugin.create({
        name: pkg.name,
        version: pkg.version,
        description: pkg.description,
        type: "NETWORK",
        onRequest(_req: Request, _res: Response, next: NextFunction) {
            // Hook logic
            next();
        },
        onServerStart(_server: PluginServer) {
            console.log("[" + pkg.name + "] Initialized");
        }
    }, __sys__.__root__);
}
    #END

    #CREATE: "scripts/inspect.ts"
import { Plugin } from "xypriss";
import { {NAME} } from "../src/index.js";

/**
 * XyPriss Plugin Inspection Script
 * 
 * This script analyzes your plugin's hooks to determine which permissions
 * are required. You must declare the discovered permissions in your
 * package.json under the `xfpm.permissions` array before signing.
 * 
 * For the complete list of available permissions, see:
 * https://xypriss.nehonix.com/docs/plugins/api-reference/hooks
 */
Plugin.inspect({NAME}());
/* @ts-ignore */
process.exit(0);
    #END

    U.LOG: "<green>[PLUGIN::SUCCESS]</> Plugin orchestration complete."
    U.LOG: "<yellow>[PLUGIN::CLEANUP]</> Removing rules directory..."
    FS.RM: "rules"
    FS.RM: ".vscode"
#END


// U.EXIT: 0 // which will allow XFPM to continue