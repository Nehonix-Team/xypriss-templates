// --------------------------------------------------------------------------
// XyPriss Default (Single-Instance Modular) Mode Rules
// --------------------------------------------------------------------------

U.LOG: "<cyan>[DEFAULT]</> Adapting project for Single-Instance Modular operation..."

// 1. CLEANUP ENVIRONMENT VARIABLES
#BEGIN: ".env"
    @INJECT: /(?m)^(AUTH_SERVER_PORT|MAIN_SERVER_PORT|CDN_SERVER_PORT|AUTH_DOMAIN|MAIN_DOMAIN|CDN_DOMAIN)=.*$\n?/
    @END
#END

// 2. CLEANUP JSONC CONFIGURATION
#BEGIN: "xypriss.config.jsonc"
    @INJECT: /(?s)[ \t]*"servers":\s*\{.*?\},\r?\n?/
    @END
#END

// 3. REMOVE MULTI-SERVER SPECIFIC FILES
FS.RM: "src/servers"
FS.RM: "src/configs/servers.config.ts"

// 4. UPDATE XYPRISS SERVER CONFIG
#BEGIN: "src/configs/xypriss.config.ts"
    @INJECT: /(?m)^import\s*\{\s*(authServer|mainServer|cdnServer).*?\r?\n/
    @END
    @INJECT: /(?s)\s*multiServer:\s*\{.*?\},/
    @END
#END

// 5. UPDATE ROUTER FOR SINGLE INSTANCE
#CREATE: "src/router.ts"
import { Router } from "xypriss";
import { apiRouter } from "./routes/api.route";
import { authRouter } from "./routes/auth.route";
import { cdnRouter } from "./routes/cdn.route";

const r = Router();

// Mount functional modules on standard route prefixes
r.use("/api", apiRouter);
r.use("/auth", authRouter);
r.use("/cdn", cdnRouter);

export { r as router };
export default r;
#END

U.LOG: "<green>[DEFAULT]</> Single-instance modular structure configured."
